    -- Summary reports: row counts
    --
    SELECT is(
        (SELECT count(*)
           FROM tax_form_summary_report(
                       -511,
                       (date1() - '1 day'::interval)::date,
                       (date1() + '1 day'::interval)::date)),
        2::bigint,
        'Current summary report has 2 rows'
    );

    SELECT is(
        (SELECT count(*)
           FROM tax_form_summary_report_accrual(
                       -511,
                       (date1() - '1 day'::interval)::date,
                       (date1() + '1 day'::interval)::date)),
        2::bigint,
        'Current accrual summary report has 2 rows'
    );

    SELECT is(
        (SELECT count(*)
           FROM tax_form_summary_report(
                       -511,
                       (date2() - '1 day'::interval)::date,
                       (date2() + '1 day'::interval)::date)),
        1::bigint,
        'Future summary report has 1 row'
    );

    SELECT is_empty(
        $$
            SELECT *
              FROM tax_form_summary_report_accrual(
                         -511,
                         (date2() - '1 day'::interval)::date,
                         (date2() + '1 day'::interval)::date)
        $$,
        'Future accrual summary report has no rows'
    );

    -- Summary reports: sums per vendor
    --
    -- Expected values, from the fixtures above. Every item has 1000 reportable
    -- (plus 10 non-reportable). A payment of 505 against an item of 1010 counts
    -- as 500 reportable (1000 * 505 / 1010).
    --
    -- tax_form_summary_report, current period:
    --   vendor 1  acc_sum     = 1000 (-1024) + 500 (-1025) + 500 (-1026) = 2000
    --             invoice_sum =  500 (-1035) + 500 (-1036)               = 1000
    --             total_sum   = 2000 + 1000                              = 3000
    --   vendor 2  acc_sum = 1000 (-1027), invoice_sum = 1000 (-1037),
    --             total_sum = 2000
    -- tax_form_summary_report_accrual, current period (full amounts):
    --   vendor 1  acc_sum     = 3 * 1000 (-1024, -1025, -1026) = 3000
    --             invoice_sum = 2 * 1000 (-1035, -1036)        = 2000
    --             total_sum   = 3000 + 2000                    = 5000
    --   vendor 2  same as the non-accrual report: 1000 / 1000 / 2000
    -- tax_form_summary_report, future period (payments of 505 each):
    --   vendor 1  acc_sum = 500 (-1026), invoice_sum = 500 (-1036),
    --             total_sum = 1000
    --
    SELECT results_eq(
        format($q$
            SELECT %I = %s
              FROM tax_form_summary_report(
                       -511,
                       (date1() - '1 day'::interval)::date,
                       (date1() + '1 day'::interval)::date)
             WHERE meta_number = %L
        $q$, t.measure, t.expected, t.vendor),
        ARRAY[TRUE],
        format('Current summary report, %s, %s = %s',
               t.label, t.measure, t.expected)
    )
      FROM (VALUES
            ('vendor 1', 'Test account 1', 'invoice_sum', 1000),
            ('vendor 2', 'Test account 2', 'invoice_sum', 1000),
            ('vendor 1', 'Test account 1', 'total_sum', 3000),
            ('vendor 2', 'Test account 2', 'total_sum', 2000),
            ('vendor 1', 'Test account 1', 'acc_sum', 2000),
            ('vendor 2', 'Test account 2', 'acc_sum', 1000)
           ) AS t(label, vendor, measure, expected);

    SELECT results_eq(
        format($q$
            SELECT %I = %s
              FROM tax_form_summary_report_accrual(
                       -511,
                       (date1() - '1 day'::interval)::date,
                       (date1() + '1 day'::interval)::date)
             WHERE meta_number = %L
        $q$, t.measure, t.expected, t.vendor),
        ARRAY[TRUE],
        format('Current accrual summary report, %s, %s = %s',
               t.label, t.measure, t.expected)
    )
      FROM (VALUES
            ('vendor 1', 'Test account 1', 'invoice_sum', 2000),
            ('vendor 2', 'Test account 2', 'invoice_sum', 1000),
            ('vendor 1', 'Test account 1', 'total_sum', 5000),
            ('vendor 2', 'Test account 2', 'total_sum', 2000),
            ('vendor 1', 'Test account 1', 'acc_sum', 3000),
            ('vendor 2', 'Test account 2', 'acc_sum', 1000)
           ) AS t(label, vendor, measure, expected);

    SELECT results_eq(
        format($q$
            SELECT %I = %s
              FROM tax_form_summary_report(
                       -511,
                       (date2() - '1 day'::interval)::date,
                       (date2() + '1 day'::interval)::date)
             WHERE meta_number = %L
        $q$, t.measure, t.expected, t.vendor),
        ARRAY[TRUE],
        format('Future summary report, %s, %s = %s',
               t.label, t.measure, t.expected)
    )
      FROM (VALUES
            ('vendor 1', 'Test account 1', 'invoice_sum', 500),
            ('vendor 1', 'Test account 1', 'total_sum', 1000),
            ('vendor 1', 'Test account 1', 'acc_sum', 500)
           ) AS t(label, vendor, measure, expected);

    -- Detail reports: row counts
    --
    -- Vendor 1, current period: -1024, -1025, -1026, -1035, -1036 = 5 rows.
    -- Vendor 2, current period: -1027, -1037 = 2 rows.
    -- Vendor 1, future period: -1026, -1036 = 2 rows; vendor 2: none.
    --
    SELECT is(
        (SELECT count(*)
           FROM tax_form_details_report(
                       -511,
                       (date1() - '1 day'::interval)::date,
                       (date1() + '1 day'::interval)::date,
                       'Test account 1')),
        5::bigint,
        'Current detail report, vendor 1, has 5 rows'
    );

    SELECT is(
        (SELECT count(*)
           FROM tax_form_details_report_accrual(
                       -511,
                       (date1() - '1 day'::interval)::date,
                       (date1() + '1 day'::interval)::date,
                       'Test account 1')),
        5::bigint,
        'Current accrual detail report, vendor 1, has 5 rows'
    );

    SELECT is(
        (SELECT count(*)
           FROM tax_form_details_report(
                       -511,
                       (date1() - '1 day'::interval)::date,
                       (date1() + '1 day'::interval)::date,
                       'Test account 2')),
        2::bigint,
        'Current detail report, vendor 2, has 2 rows'
    );

    SELECT is(
        (SELECT count(*)
           FROM tax_form_details_report_accrual(
                       -511,
                       (date1() - '1 day'::interval)::date,
                       (date1() + '1 day'::interval)::date,
                       'Test account 2')),
        2::bigint,
        'Current accrual detail report, vendor 2, has 2 rows'
    );

    SELECT is(
        (SELECT count(*)
           FROM tax_form_details_report(
                       -511,
                       (date2() - '1 day'::interval)::date,
                       (date2() + '1 day'::interval)::date,
                       'Test account 1')),
        2::bigint,
        'Future detail report, vendor 1, has 2 rows'
    );

    SELECT is_empty(
        $$
            SELECT *
              FROM tax_form_details_report(
                         -511,
                         (date2() - '1 day'::interval)::date,
                         (date2() + '1 day'::interval)::date,
                         'Test account 2')
        $$,
        'Future detail report, vendor 2, has no rows'
    );

    -- Detail reports: amounts per invoice
    --
    -- Expected values follow the same arithmetic as the summary reports above:
    -- tax_form_details_report: values match pro rata payments (e.g. -1025:
    -- 505 of 1010 -> 500). tax_form_details_report_accrual: the full 1000 per
    -- item. In every row total_sum = acc_sum + invoice_sum.
    --
    SELECT results_eq(
        format($q$
            SELECT %I = %s
              FROM tax_form_details_report(
                       -511,
                       (date1() - '1 day'::interval)::date,
                       (date1() + '1 day'::interval)::date,
                       %L)
             WHERE invoice_id = %s
        $q$, t.measure, t.expected, t.vendor, t.invoice_id),
        ARRAY[TRUE],
        format('Current detail report, %s, %s = %s',
               t.label, t.measure, t.expected)
    )
      FROM (VALUES
            ('invoice -1024', 'Test account 1', -1024, 'acc_sum', 1000),
            ('invoice -1025', 'Test account 1', -1025, 'acc_sum', 500),
            ('invoice -1026', 'Test account 1', -1026, 'acc_sum', 500),
            ('invoice -1027', 'Test account 2', -1027, 'acc_sum', 1000),
            ('invoice -1024', 'Test account 1', -1024, 'total_sum', 1000),
            ('invoice -1025', 'Test account 1', -1025, 'total_sum', 500),
            ('invoice -1026', 'Test account 1', -1026, 'total_sum', 500),
            ('invoice -1027', 'Test account 2', -1027, 'total_sum', 1000),
            ('invoice -1024', 'Test account 1', -1024, 'invoice_sum', 0),
            ('invoice -1025', 'Test account 1', -1025, 'invoice_sum', 0),
            ('invoice -1026', 'Test account 1', -1026, 'invoice_sum', 0),
            ('invoice -1027', 'Test account 2', -1027, 'invoice_sum', 0),
            ('invoice -1035', 'Test account 1', -1035, 'invoice_sum', 500),
            ('invoice -1036', 'Test account 1', -1036, 'invoice_sum', 500),
            ('invoice -1037', 'Test account 2', -1037, 'invoice_sum', 1000),
            ('invoice -1035', 'Test account 1', -1035, 'total_sum', 500),
            ('invoice -1036', 'Test account 1', -1036, 'total_sum', 500),
            ('invoice -1037', 'Test account 2', -1037, 'total_sum', 1000),
            ('invoice -1035', 'Test account 1', -1035, 'acc_sum', 0),
            ('invoice -1036', 'Test account 1', -1036, 'acc_sum', 0),
            ('invoice -1037', 'Test account 2', -1037, 'acc_sum', 0)
           ) AS t(label, vendor, invoice_id, measure, expected);

    SELECT results_eq(
        format($q$
            SELECT %I = %s
              FROM tax_form_details_report_accrual(
                       -511,
                       (date1() - '1 day'::interval)::date,
                       (date1() + '1 day'::interval)::date,
                       %L)
             WHERE invoice_id = %s
        $q$, t.measure, t.expected, t.vendor, t.invoice_id),
        ARRAY[TRUE],
        format('Current accrual detail report, %s, %s = %s',
               t.label, t.measure, t.expected)
    )
      FROM (VALUES
            ('invoice -1024', 'Test account 1', -1024, 'acc_sum', 1000),
            ('invoice -1025', 'Test account 1', -1025, 'acc_sum', 1000),
            ('invoice -1026', 'Test account 1', -1026, 'acc_sum', 1000),
            ('invoice -1027', 'Test account 2', -1027, 'acc_sum', 1000),
            ('invoice -1024', 'Test account 1', -1024, 'total_sum', 1000),
            ('invoice -1025', 'Test account 1', -1025, 'total_sum', 1000),
            ('invoice -1026', 'Test account 1', -1026, 'total_sum', 1000),
            ('invoice -1027', 'Test account 2', -1027, 'total_sum', 1000),
            ('invoice -1024', 'Test account 1', -1024, 'invoice_sum', 0),
            ('invoice -1025', 'Test account 1', -1025, 'invoice_sum', 0),
            ('invoice -1026', 'Test account 1', -1026, 'invoice_sum', 0),
            ('invoice -1027', 'Test account 2', -1027, 'invoice_sum', 0),
            ('invoice -1035', 'Test account 1', -1035, 'invoice_sum', 1000),
            ('invoice -1036', 'Test account 1', -1036, 'invoice_sum', 1000),
            ('invoice -1037', 'Test account 2', -1037, 'invoice_sum', 1000),
            ('invoice -1035', 'Test account 1', -1035, 'total_sum', 1000),
            ('invoice -1036', 'Test account 1', -1036, 'total_sum', 1000),
            ('invoice -1037', 'Test account 2', -1037, 'total_sum', 1000),
            ('invoice -1035', 'Test account 1', -1035, 'acc_sum', 0),
            ('invoice -1036', 'Test account 1', -1036, 'acc_sum', 0),
            ('invoice -1037', 'Test account 2', -1037, 'acc_sum', 0)
           ) AS t(label, vendor, invoice_id, measure, expected);

    SELECT results_eq(
        format($q$
            SELECT %I = %s
              FROM tax_form_details_report(
                       -511,
                       (date2() - '1 day'::interval)::date,
                       (date2() + '1 day'::interval)::date,
                       %L)
             WHERE invoice_id = %s
        $q$, t.measure, t.expected, t.vendor, t.invoice_id),
        ARRAY[TRUE],
        format('Future detail report, %s, %s = %s',
               t.label, t.measure, t.expected)
    )
      FROM (VALUES
            ('invoice -1026', 'Test account 1', -1026, 'acc_sum', 500),
            ('invoice -1026', 'Test account 1', -1026, 'invoice_sum', 0),
            ('invoice -1026', 'Test account 1', -1026, 'total_sum', 500),
            ('invoice -1036', 'Test account 1', -1036, 'acc_sum', 0),
            ('invoice -1036', 'Test account 1', -1036, 'invoice_sum', 500),
            ('invoice -1036', 'Test account 1', -1036, 'total_sum', 500)
           ) AS t(label, vendor, invoice_id, measure, expected);

    -- Finish the tests and clean up.
    SELECT * FROM finish();

ROLLBACK;
