/*

*igning tests. Thinking:

1) Correct number of lines on summary report
2) Correct total on summary report
3) Correct number of lines on detail report
4) Correct totals on detail report
5) Correct total summary report for future year
6) Correct number of lines for report on future year
7) Correct number of lines on detail report for futture year
8) Correct totals on lines of details report for future year

Invoices 8:

1) AP transaction: Reportable amount 1000, non-reportable amount $10, paid
in full in current year.
2) AP transaction: Reportable amount $1000, non-reportable amount $10,
partially paid ($500) in current year
3) AP Transaction: Reportable amount $1000, non-reportable amount $10,
paid $500 currnet year, $500 in future year

4) AP invoice: Reportable amount 1000, non-reportable amount $10, paid in
full in current year.
5) AP invoice: Reportable amount $1000, non-reportable amount $10,
partially paid ($500) in current year
6) AP invice: Reportable amount $1000, non-reportable amount $10, paid
$500 currnet year, $500 in future year

7 like 1 but different vendor
8 like 4 but different vendor

--CT

*/

BEGIN;
    -- Load the TAP functions.
    CREATE EXTENSION pgtap;
    SET client_min_messages TO warning;

    -- Plan the tests.

    SELECT plan(84);

    -- Add data

    \i xt/data/42-pg/Base.sql

    -- =========================================================================
    -- SETUP
    -- =========================================================================

    -- Helper functions used by the fixtures and the tests.
    --
    -- date1(): December 1st of the current year (the "current" period).
    CREATE OR REPLACE FUNCTION date1() RETURNS date AS
    $$
        SELECT (extract('YEAR' FROM now()) || '-12-01')::date;
    $$ LANGUAGE SQL;

    -- date2(): December 1st of the following year (the "future" period).
    CREATE OR REPLACE FUNCTION date2() RETURNS date AS
    $$
        SELECT ((extract('YEAR' FROM now()) || '-12-01')::date
                + '1 year'::interval)::date;
    $$ LANGUAGE SQL;

    -- Id legend (all fixture ids are negative).
    --
    -- Not created in this file (presumably supplied by Base.sql / the schema):
    --   entities -100, -101 (referenced by the ECAs and company rows),
    --   accounts -1000, -1001, -1002 (linked below as AP, AP_amount, AP_paid),
    --   country 232, currency 'XTS'.
    --
    -- Created in this file:
    --   -511             country_tax_form ("Testing Form")
    --   -255, -256       account_heading/account ids; the same numbers are also
    --                    the parts ids and the entity_credit_account ids
    --                    (vendor 1 = -255, vendor 2 = -256)
    --   -1024, -1025     company ids (the same numbers as two AP transactions)
    --   -1024 .. -1027   AP transactions (trans_id)
    --   -1035 .. -1037   invoice transactions stored in ar (trans_id)
    --   -111 .. -145     acc_trans entry_ids of -1024 .. -1027
    --   -221 .. -245     acc_trans entry_ids of -1035 .. -1037
    --   -211, -212       invoice line ids of -1035
    --   -221, -222       invoice line ids of -1036 (same numbers as entry_ids
    --                    -221, -222 of -1035; different tables)
    --   -231, -232       invoice line ids of -1037 (same numbers as entry_ids
    --                    -231, -232 of -1036; different tables)

    -- =========================================================================
    -- SCHEMA CHECKS
    -- =========================================================================

    -- -------------------------------------------------------------------------
    -- Tests
    -- -------------------------------------------------------------------------

    -- Validate required tables
    SELECT has_table(t.table_name::name)
      FROM (VALUES
            ('ac_tax_form'),
            ('country_tax_form'),
            ('eca_tax'),
            ('invoice_tax_form'),
            ('tax'),
            ('tax_extended'),
            ('taxmodule')
           ) AS t(table_name);

    -- Validate required functions
    SELECT has_function(t.function_name::name, t.arg_types::name[])
      FROM (VALUES
            ('tax_form__get', ARRAY['integer']),
            ('tax_form__list_all', '{}'::text[]),
            ('tax_form__list_ext', '{}'::text[]),
            ('tax_form__save',
             ARRAY['integer', 'integer', 'text', 'boolean', 'boolean'])
           ) AS t(function_name, arg_types);

