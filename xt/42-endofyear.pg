BEGIN;
    -- ====================================================================
    -- SETUP
    -- ====================================================================

    -- Load the TAP functions.
    CREATE EXTENSION pgtap;
    SET client_min_messages TO warning;

    -- Plan the tests.

    SELECT plan(21);

    -- Add data

    \i xt/data/42-pg/Base.sql

    -- Id legend (ids are used literally; only the transactions and
    -- acc_trans rows are created by this file):
    --   -1000, -1001  transactions.id / acc_trans.trans_id of the two
    --                 balance-scenario transactions. The same numbers are
    --                 reused as acc_trans.chart_id: -1000 is the +10000
    --                 line and -1001 the -10000 line of each transaction.
    --   -1002         4th argument of eoy_close_books; not created here.
    --   -1003, -1004  acc_trans.chart_id of the zeroing scenario (+10000
    --                 and -10000 lines respectively).
    --   -1005         4th argument of eoy_zero_accounts; not created here.
    --   -1010         transactions.id / acc_trans.trans_id of the zeroing
    --                 scenario.
    -- Chart ids -1000 .. -1005 are not created in this file; they are
    -- presumably supplied by Base.sql or the schema (not verified).

    -- ====================================================================
    -- SCHEMA CHECKS: required tables and functions
    -- ====================================================================

    -- ---- Tests ---------------------------------------------------------

    -- Required tables
    SELECT has_table('acc_trans');
    SELECT has_table('gl');

    -- Required functions (one assertion per row)
    SELECT has_function(fn_name, arg_types)
      FROM (VALUES
                ('account__obtain_balance', ARRAY['date', 'integer']),
                ('account__obtain_starting_balance',
                 ARRAY['date', 'integer']),
                ('eoy__latest_checkpoint', '{}'::text[]),
                ('eoy__reopen_books_at', ARRAY['date']),
                ('eoy_close_books',
                 ARRAY['date', 'text', 'text', 'integer']),
                ('eoy_create_checkpoint', ARRAY['date']),
                ('eoy_earnings_accounts', '{}'::text[]),
                ('eoy_reopen_books', ARRAY['date']),
                ('eoy_zero_accounts',
                 ARRAY['date', 'text', 'text', 'integer'])
           ) AS t(fn_name, arg_types);

    -- ====================================================================
    -- BALANCES WITHOUT A CHECKPOINT (account__obtain_balance)
    -- ====================================================================

    -- ---- Fixtures ------------------------------------------------------

    INSERT INTO transactions
           (id, reference, description, transdate, approved,
            trans_type_code)
    VALUES (-1000, 'test', 'test', '1520-01-01', TRUE,
            'gl'); -- way in the future.
    INSERT INTO acc_trans
           (trans_id, chart_id, transdate, amount_bc, curr, amount_tc,
            approved)
    VALUES (-1000, -1000, '1520-01-01', 10000, 'XTS', 10000, TRUE);
    INSERT INTO acc_trans
           (trans_id, chart_id, transdate, amount_bc, curr, amount_tc,
            approved)
    VALUES (-1000, -1001, '1520-01-01', -10000, 'XTS', -10000, TRUE);

    INSERT INTO transactions
           (id, reference, description, transdate, approved,
            trans_type_code)
    VALUES (-1001, 'test', 'test', '1520-06-01', TRUE,
            'gl'); -- way in the future.
    INSERT INTO acc_trans
           (trans_id, chart_id, transdate, amount_bc, curr, amount_tc,
            approved)
    VALUES (-1001, -1000, '1520-06-01', 10000, 'XTS', 10000, TRUE);
    INSERT INTO acc_trans
           (trans_id, chart_id, transdate, amount_bc, curr, amount_tc,
            approved)
    VALUES (-1001, -1001, '1520-06-01', -10000, 'XTS', -10000, TRUE);

    -- ---- Tests ---------------------------------------------------------

    -- Account -1000 gets +10000 on 1520-01-01 (tx -1000) and +10000 on
    -- 1520-06-01 (tx -1001), so its balance is 0, 10000 and 20000 on the
    -- three dates below. One assertion per row.
    SELECT results_eq(
               format(
                   $$ SELECT account__obtain_balance(%L::date, -1000) = %s $$,
                   as_of, expected
               ),
               ARRAY[true],
               'account__obtain_balance: ' || label
           )
      FROM (VALUES
                ('0 before any transaction', '1519-12-31', 0),
                ('10000 after first transaction', '1520-01-01', 10000),
                ('20000 after second transaction', '1520-06-01', 20000)
           ) AS t(label, as_of, expected);

    -- ====================================================================
    -- CLOSING BOOKS (eoy_close_books): checkpoint and balances
    -- ====================================================================

    -- ---- Fixtures ------------------------------------------------------

    DELETE FROM account_checkpoint;
    DELETE FROM yearend;

    -- ---- Tests ---------------------------------------------------------

    -- Order-sensitive: eoy_close_books has side effects (it creates the
    -- checkpoint that every later assertion in this section relies on),
    -- so this assertion must stay first and run exactly once.
    SELECT results_eq(
               $$ SELECT eoy_close_books('1520-05-01', 'test', 'test',
                                         '-1002') $$,
               ARRAY[true],
               'eoy_close_books: closing books at 1520-05-01 succeeds'
           );

    -- The checkpoint at 1520-05-01 only covers tx -1000 (+10000 on
    -- 1520-01-01); tx -1001 (1520-06-01) is later.
    SELECT results_eq(
               $$ SELECT amount_bc = 10000
                    FROM account_checkpoint
                   WHERE end_date = '1520-05-01' AND account_id = -1000 $$,
               ARRAY[true],
               'Checkpoint added: account -1000, 1520-05-01, amount_bc 10000'
           );

    -- Balance = checkpoint (10000) + transactions after it: none up to
    -- 1520-05-02, tx -1001 (+10000) on 1520-06-01 -> 10000, 10000, 20000.
    -- One assertion per row.
    SELECT results_eq(
               format(
                   $$ SELECT account__obtain_balance(%L::date, -1000) = %s $$,
                   as_of, expected
               ),
               ARRAY[true],
               'account__obtain_balance: ' || label
           )
      FROM (VALUES
                ('10000 on checkpoint date', '1520-05-01', 10000),
                ('10000 after checkpoint, no transactions in between',
                 '1520-05-02', 10000),
                ('20000 after checkpoint and a later transaction',
                 '1520-06-01', 20000)
           ) AS t(label, as_of, expected);

    -- ====================================================================
    -- ZEROING ACCOUNTS (eoy_zero_accounts)
    -- ====================================================================

    -- ---- Fixtures ------------------------------------------------------

    DELETE FROM account_checkpoint;
    INSERT INTO currency VALUES ('xts', 'xts');

    INSERT INTO transactions
           (id, reference, description, transdate, approved,
            trans_type_code)
    VALUES (-1010, 'test', 'test', '1519-01-01', TRUE,
            'gl'); -- way in the future.
    -- Per currency, chart -1003 holds +10000 and chart -1004 holds -10000
    -- (amount_tc: +/-10000 for 'XTS', +/-1 for 'xts').
    INSERT INTO acc_trans
           (trans_id, chart_id, transdate, amount_bc, curr, amount_tc,
            approved)
    VALUES (-1010, -1003, '1519-01-01', 10000, 'XTS', 10000, TRUE),
           (-1010, -1004, '1519-01-01', -10000, 'XTS', -10000, TRUE),
           (-1010, -1003, '1519-01-01', 10000, 'xts', 1, TRUE),
           (-1010, -1004, '1519-01-01', -10000, 'xts', -1, TRUE);

    -- Call under test (not an assertion): its effects are checked below.
    -- The returned row is printed by psql and its value is not asserted.
    SELECT eoy_zero_accounts('1519-01-02', 'test', 'test-zero', -1005);

    -- ---- Tests ---------------------------------------------------------

    -- Expected sums are 0: the fixture rows (+10000 / -10000 per currency)
    -- are offset by eoy_zero_accounts.
    SELECT results_eq(
               $$ SELECT chart_id, sum(amount_bc), sum(amount_tc)
                    FROM acc_trans
                   WHERE curr = 'XTS' AND transdate <= '1519-01-03'
                         AND chart_id IN (-1003, -1004)
                   GROUP BY chart_id
                   ORDER BY chart_id $$,
               $$ VALUES (-1004, 0::numeric, 0::numeric),
                         (-1003, 0::numeric, 0::numeric) $$,
               'eoy_zero_accounts: XTS currency cleared (charts -1003, -1004)'
           );

    SELECT results_eq(
               $$ SELECT chart_id, sum(amount_bc), sum(amount_tc)
                    FROM acc_trans
                   WHERE curr = 'xts' AND transdate <= '1519-01-03'
                         AND chart_id IN (-1003, -1004)
                   GROUP BY chart_id
                   ORDER BY chart_id $$,
               $$ VALUES (-1004, 0::numeric, 0::numeric),
                         (-1003, 0::numeric, 0::numeric) $$,
               'eoy_zero_accounts: "xts" currency cleared (charts -1003, -1004)'
           );

    -- ====================================================================
    -- FINISH
    -- ====================================================================

    -- Finish the tests and clean up.
    SELECT * FROM finish();

ROLLBACK;
