BEGIN;
    -- Load the TAP functions.
    CREATE EXTENSION pgtap;
    SET client_min_messages TO warning;


    -- ========================================================================
    -- Setup
    -- ========================================================================

    -- Plan the tests.

    SELECT plan(175);

    -- Add data

    \i xt/data/42-pg/Base.sql

    -- Id legend:
    --   * Role names starting with '42_working_role' belong to this file.
    --     '42_working_role' is created by lsmb__create_role below and reused
    --     by every later section; '42_working_role_not_defined' is
    --     deliberately never created.
    --   * Menu id 252 is not created in this file (it is expected to come from
    --     the data above or the schema); -1 is a deliberately non-existent
    --     menu id.
    --   * Roles such as budget_view, base_user, file_read and contact_read
    --     are not created in this file either.

    -- Helper for the read-permission tests.
    -- Returns TRUE when information_schema.role_table_grants contains at
    -- least one SELECT grant on table relspec in schema 'xyz' (the rolname
    -- argument is not used in the body).
    --
    -- This function is vulnerable to SQL injection but it is transient for the
    -- purposes of these test cases. In particular it is intended only to ensure
    -- that basic permissions are tested.
    --
    -- IT IS THE RESPONSIBILITY OF TEST CASE AUTHORS TO ENSURE THAT THE USAGE OF
    -- THIS FUNCTION IS SAFE.
    CREATE OR REPLACE FUNCTION test__has_select_permission
                                (rolname name, relspec text)
    RETURNS bool LANGUAGE plpgsql AS
    $$
    BEGIN
        PERFORM * FROM information_schema.role_table_grants
          WHERE table_schema = 'xyz'
                AND table_name = relspec
                AND privilege_type = 'SELECT';

        RETURN FOUND;
    END;
    $$;


    -- ========================================================================
    -- Required tables
    -- ========================================================================

    -- ---- Tests ----

    SELECT has_table('lsmb_module');


    -- ========================================================================
    -- lsmb__create_role
    -- ========================================================================

    -- ---- Tests ----

    -- Can create role
    SELECT has_function('lsmb__create_role', ARRAY['text', 'text']);

    -- Check Valid Role creation
    SELECT results_eq(
        $$ SELECT lsmb__create_role('42_working_role', 'role docs') $$,
        ARRAY[true],
        'lsmb__create_role can create a normal role'
    );

    -- ---- Fixtures ----
    -- (Must stay between the two assertions around it: it follows the role
    -- creation above and precedes the name-too-long check below.)

    SELECT lsmb__grant_role('42_working_role', 'base_user');

    -- ---- Tests ----

    -- Check with an invalid role name of 86 characters total
    SELECT throws_ok(
        $$
            SELECT lsmb__create_role(
                '42_failing_with_a_much_too_long_role_that_will_have_more_then_63_bytes',
                'role docs'
            )
        $$,
        '42622' -- 42622 is name_too_long
    );


    -- ========================================================================
    -- lsmb__grant_exec
    -- (uses 42_working_role created in the lsmb__create_role section)
    -- ========================================================================

    -- ---- Tests ----

    -- Can grant function execution
    SELECT has_function('lsmb__grant_exec', ARRAY['text', 'text']);

    -- Check valid case
    SELECT results_eq(
        $$
            SELECT lsmb__grant_exec(
                '42_working_role',
                'budget__save_info(integer,date,date,text,text,integer[])'
            )
        $$,
        ARRAY[true],
        'lsmb__grant_exec can grant exec on a defined function to a defined role'
    );

    -- Validate undefined role
    SELECT throws_ok(
        $$
            SELECT lsmb__grant_exec(
                '42_working_role_not_defined',
                'budget__save_info(integer,date,date,text,text,integer[])'
            )
        $$,
        '0P000'
    );

    -- Validate invalid function
    SELECT throws_ok(
        $$
            SELECT lsmb__grant_exec(
                '42_working_role',
                'budget__save_info_not_defined(integer,date,date,text,text,integer[])'
            )
        $$,
        '42883'
    );


    -- ========================================================================
    -- lsmb__grant_menu
    -- (uses 42_working_role created in the lsmb__create_role section)
    -- ========================================================================

    -- ---- Tests ----

    -- Can grant submenu access
    SELECT has_function('lsmb__grant_menu', ARRAY['text', 'integer', 'text']);

    -- Check valid case
    SELECT results_eq(
        $$ SELECT lsmb__grant_menu('42_working_role', 252, 'allow') $$,
        ARRAY[true],
        'lsmb__grant_menu can grant submenu access to a defined role'
    );

    -- Validate undefined role
    SELECT throws_ok(
        $$ SELECT lsmb__grant_menu('42_working_role_not_defined', 252, 'allow') $$,
        '0P000'
    );

    -- Validate undefined submenu
    SELECT throws_ok(
        $$ SELECT lsmb__grant_menu('42_working_role', -1, 'allow') $$,
        '23503'
    );

    -- Validate undefined role
    SELECT throws_ok(
        $$ SELECT lsmb__grant_menu('42_working_role', 252, 'allow_special') $$,
        '0L000'
    );


    -- ========================================================================
    -- lsmb__grant_perms
    -- (uses 42_working_role created in the lsmb__create_role section)
    -- ========================================================================

    -- ---- Tests ----

    -- Can grant permission with 4 arguments
    SELECT has_function(
        'lsmb__grant_perms', ARRAY['text', 'text', 'text', 'text[]']
    );

    -- Not used?

    -- Can grant permission
    SELECT has_function('lsmb__grant_perms', ARRAY['text', 'text', 'text']);

    -- Valid case
    SELECT results_eq(
        $$
            SELECT lsmb__grant_perms('42_working_role', 'budget_info', 'SELECT')
        $$,
        ARRAY[true],
        'lsmb__grant_perms can grant SELECT on budget_info to a defined role'
    );

    -- Validate undefined role
    SELECT throws_ok(
        $$
            SELECT lsmb__grant_perms(
                '42_working_role_not_defined', 'budget_info', 'SELECT'
            )
        $$,
        '0P000'
    );

    -- Validate undefined permission
    SELECT throws_ok(
        $$
            SELECT lsmb__grant_perms(
                '42_working_role', 'budget_info_not_defined', 'SELECT'
            )
        $$,
        '42P01'
    );

    -- Validate invalid type
    SELECT throws_ok(
        $$
            SELECT lsmb__grant_perms(
                '42_working_role', 'budget_info', 'SELECT_SPECIAL'
            )
        $$,
        '0L000'
    );


    -- ========================================================================
    -- lsmb__grant_role
    -- (uses 42_working_role created in the lsmb__create_role section)
    -- ========================================================================

    -- ---- Tests ----

    -- Can grant role
    SELECT has_function('lsmb__grant_role', ARRAY['text', 'text']);

    -- Check valid case
    SELECT results_eq(
        $$ SELECT lsmb__grant_role('42_working_role', 'budget_view') $$,
        ARRAY[true],
        'lsmb__grant_role can grant a defined role to a defined role'
    );

    -- Validate undefined role
    SELECT throws_ok(
        $$
            SELECT lsmb__grant_role('42_working_role_not_defined', 'budget_view')
        $$,
        '0P000'
    );

    -- Validate undefined role
    SELECT throws_ok(
        $$
            SELECT lsmb__grant_role('42_working_role', 'budget_view_not_defined')
        $$,
        '0P000'
    );


    -- ========================================================================
    -- lsmb__is_allowed_role
    -- (uses 42_working_role created in the lsmb__create_role section)
    -- ========================================================================

    -- ---- Tests ----

    -- Can check role allowed
    SELECT has_function('lsmb__is_allowed_role', ARRAY['text[]']);

    -- Check valid case
    SELECT results_eq(
        $$ SELECT lsmb__is_allowed_role(ARRAY['42_working_role']) $$,
        ARRAY[true],
        'lsmb__is_allowed_role returns true for a defined role'
    );

    -- Validate undefined role
    SELECT throws_ok(
        $$ SELECT lsmb__is_allowed_role(ARRAY['42_working_role_not_defined']) $$,
        '42704'
    );


    -- ========================================================================
    -- Other required functions
    -- ========================================================================

    -- ---- Tests ----

    SELECT has_function('quote_ident_array', ARRAY['text[]']);
    SELECT has_function('tg_enforce_perms_eclass', '{}'::text[]);


    -- ========================================================================
    -- READ PERMISSIONS
    -- (uses the test__has_select_permission helper defined in Setup)
    -- ========================================================================

    -- ---- Tests: budget_view and file_read ----

    SELECT results_eq(
        format($$ SELECT test__has_select_permission(%L, %L) $$,
               t.rolname, t.relspec),
        ARRAY[true],
        t.rolname || ' can read ' || t.relspec
    ) FROM (VALUES
        ('budget_view', 'budget_info'),
        ('budget_view', 'budget_line'),
        ('file_read', 'file_base'),
        ('file_read', 'file_links'),
        ('file_read', 'file_secondary_attachment'),
        ('file_read', 'file_order'),
        ('file_read', 'file_part')
    ) AS t(rolname, relspec);

    -- ---- Tests: contact_read ----

    SELECT results_eq(
        format($$ SELECT test__has_select_permission(%L, %L) $$,
               'contact_read', t),
        ARRAY[true],
        'contact_read can read ' || t
    ) FROM unnest(ARRAY[
        'partsvendor'::text, 'partscustomer', 'taxcategory', 'entity',
        'company', 'location', 'entity_to_location', 'entity_to_contact',
        'person', 'entity_credit_account', 'contact_class', 'eca_tax',
        'entity_class', 'entity_note', 'entity_bank_account',
        'entity_other_name', 'location_class', 'person_to_company',
        'eca_to_contact', 'eca_to_location', 'eca_note',
        'pricegroup'
    ]) AS t;

    -- ---- Tests: ar_transaction_list ----

    SELECT results_eq(
        format($$ SELECT test__has_select_permission(%L, %L) $$,
               'ar_transaction_list', t),
        ARRAY[true],
        'ar_transaction_list can read ' || t
    ) FROM unnest(ARRAY[
        'partsvendor'::text, 'partscustomer', 'taxcategory', 'entity',
        'company', 'location', 'entity_to_location', 'entity_to_contact',
        'person', 'entity_credit_account', 'contact_class', 'eca_tax',
        'entity_class', 'entity_note', 'entity_bank_account',
        'entity_other_name', 'location_class', 'person_to_company',
        'eca_to_contact', 'eca_to_location', 'eca_note',
        'ar', 'acc_trans', 'invoice', 'ac_tax_form', 'invoice_tax_form'
    ]) AS t;

    -- ---- Tests: ap_transaction_list ----

    SELECT results_eq(
        format($$ SELECT test__has_select_permission(%L, %L) $$,
               'ap_transaction_list', t),
        ARRAY[true],
        'ap_transaction_list can read ' || t
    ) FROM unnest(ARRAY[
        'partsvendor'::text, 'partscustomer', 'taxcategory', 'entity',
        'company', 'location', 'entity_to_location', 'entity_to_contact',
        'person', 'entity_credit_account', 'contact_class', 'eca_tax',
        'entity_class', 'entity_note', 'entity_bank_account',
        'entity_other_name', 'location_class', 'person_to_company',
        'eca_to_contact', 'eca_to_location', 'eca_note',
        'ap', 'acc_trans', 'invoice', 'ac_tax_form', 'invoice_tax_form'
    ]) AS t;

    -- ---- Tests: sales_order_list ----

    SELECT results_eq(
        format($$ SELECT test__has_select_permission(%L, %L) $$,
               'sales_order_list', t),
        ARRAY[true],
        'sales_order_list can read ' || t
    ) FROM unnest(ARRAY[
        'partsvendor'::text, 'partscustomer', 'taxcategory', 'entity',
        'company', 'location', 'entity_to_location', 'entity_to_contact',
        'person', 'entity_credit_account', 'contact_class', 'eca_tax',
        'entity_class', 'entity_note', 'entity_bank_account',
        'entity_other_name', 'location_class', 'person_to_company',
        'eca_to_contact', 'eca_to_location', 'eca_note',
        'oe', 'orderitems'
    ]) AS t;

    -- ---- Tests: purchase_order_list ----

    SELECT results_eq(
        format($$ SELECT test__has_select_permission(%L, %L) $$,
               'purchase_order_list', t),
        ARRAY[true],
        'purchase_order_list can read ' || t
    ) FROM unnest(ARRAY[
        'partsvendor'::text, 'partscustomer', 'taxcategory', 'entity',
        'company', 'location', 'entity_to_location', 'entity_to_contact',
        'person', 'entity_credit_account', 'contact_class', 'eca_tax',
        'entity_class', 'entity_note', 'entity_bank_account',
        'entity_other_name', 'location_class', 'person_to_company',
        'eca_to_contact', 'eca_to_location', 'eca_note',
        'oe', 'orderitems'
    ]) AS t;

    -- ---- Tests: inventory_reports ----

    SELECT results_eq(
        format($$ SELECT test__has_select_permission(%L, %L) $$,
               'inventory_reports', t),
        ARRAY[true],
        'inventory_reports can read ' || t
    ) FROM unnest(ARRAY[
        'ar'::text, 'ap', 'warehouse_inventory', 'invoice', 'acc_trans'
    ]) AS t;

    -- ---- Tests: gl_reports ----

    SELECT results_eq(
        format($$ SELECT test__has_select_permission(%L, %L) $$,
               'gl_reports', t),
        ARRAY[true],
        'gl_reports can read ' || t
    ) FROM unnest(ARRAY[
        'gl'::text, 'acc_trans', 'account_checkpoint', 'ar', 'ap',
        'entity', 'entity_credit_account'
    ]) AS t;

    -- ---- Tests: financial_reports ----

    SELECT results_eq(
        format($$ SELECT test__has_select_permission(%L, %L) $$,
               'financial_reports', t),
        ARRAY[true],
        'financial_reports can read ' || t
    ) FROM unnest(ARRAY[
        'gl'::text, 'acc_trans', 'account_checkpoint', 'ar', 'ap',
        'entity', 'entity_credit_account', 'cash_impact'
    ]) AS t;


    -- ========================================================================
    -- Finish
    -- ========================================================================

    -- Finish the tests and clean up.
    SELECT * FROM finish();

ROLLBACK;
