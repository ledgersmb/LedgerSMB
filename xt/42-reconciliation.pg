BEGIN;

    -- ======================================================================
    -- Setup
    -- ======================================================================

    -- Load the TAP functions.
    CREATE EXTENSION pgtap;
    SET client_min_messages TO warning;

    -- Plan the tests.
    SELECT plan(64);

    -- Add data
    \i xt/data/42-pg/Base.sql
    \i xt/data/42-pg/Reconciliation.sql

    -- Id legend (none of these rows or helpers are created in this file):
    --   * Accounts are addressed by account number and resolved to an account
    --     id with test_get_account_id(): '-11111', '-11112' and '-11113'.
    --     Each account has its own scenario below.
    --   * Transaction id -214 is approved in the '-11112' scenario. The same
    --     id is used as transactions.id and as acc_trans.trans_id.
    --   * Report ids come from cr_report_id_seq. test_parameters.id (created in
    --     the first scenario) holds the sequence value taken before the first
    --     report is created; later expected report ids are offsets from it
    --     (+1 ... +4), one per report created through
    --     reconciliation__new_report().
    --   * currval('workflow_seq') must already be set when the first report is
    --     created, so the include files are expected to call nextval on it.

    -- ======================================================================
    -- Schema objects
    -- ======================================================================

    -- ---- Tests -----------------------------------------------------------

    -- Validate required tables
    SELECT has_table(t.table_name::name)
    FROM (VALUES
        ('cr_report'),
        ('cr_report_line'),
        ('cr_coa_to_account')
    ) AS t(table_name);

    -- Validate required view
    SELECT has_view('recon_payee');

    -- Validate required triggers
    SELECT has_trigger('cr_report', 'block_change_when_approved');

    -- Validate required functions
    SELECT has_function(t.func::name, t.arg_types::name[])
    FROM (VALUES
        ('cr_report_block_changing_approved', '{}'::text[]),
        ('reconciliation__account_list', '{}'::text[]),
        ('reconciliation__add_entry',
            ARRAY['integer', 'text', 'text', 'timestamp without time zone',
                'numeric']),
        ('reconciliation__check', ARRAY['date', 'integer']),
        ('reconciliation__delete_my_report', ARRAY['integer']),
        ('reconciliation__delete_unapproved', ARRAY['integer']),
        ('reconciliation__get_cleared_balance',
            ARRAY['integer', 'date', 'boolean']),
        ('reconciliation__get_current_balance', ARRAY['integer', 'date']),
        ('reconciliation__new_report',
            ARRAY['integer', 'numeric', 'date', 'boolean', 'bigint']),
        ('reconciliation__pending_transactions', ARRAY['integer', 'numeric']),
        ('reconciliation__previous_report_date', ARRAY['integer', 'date']),
        ('reconciliation__reject_set', ARRAY['integer']),
        ('reconciliation__report_approve', ARRAY['integer']),
        ('reconciliation__report_details', ARRAY['integer']),
        ('reconciliation__report_details_payee', ARRAY['integer']),
        ('reconciliation__report_details_payee_with_days',
            ARRAY['integer', 'date']),
        ('reconciliation__report_summary', ARRAY['integer']),
        ('reconciliation__save_set', ARRAY['integer', 'integer[]']),
        ('reconciliation__search',
            ARRAY['date', 'date', 'numeric', 'numeric', 'integer',
                'boolean', 'boolean']),
        ('reconciliation__submit_set', ARRAY['integer'])
    ) AS t(func, arg_types);

    -- ======================================================================
    -- Account -11111: first report (create, delete, re-create)
    -- ======================================================================

    -- ---- Fixtures --------------------------------------------------------

    -- Disabled in the original file (commented-out code, kept verbatim):
--    PREPARE test AS SELECT count(*)
--                      FROM defaults
--                      WHERE setting_key = 'check_prefix';
--    SELECT results_eq('test',ARRAY[1],'check_prefix set');

--    UPDATE defaults
--    SET value = 'Recon gl test '
--    WHERE setting_key = 'check_prefix';

    -- Report id baseline. Also used by the later scenarios (id + 3, id + 4).
    CREATE TEMPORARY TABLE test_parameters (id int);
    INSERT INTO test_parameters (id)
    VALUES (nextval('cr_report_id_seq'));

    -- ---- Tests -----------------------------------------------------------

    SELECT is_empty(
        $$
            SELECT reconciliation__previous_report_date(
                test_get_account_id('-11111'), now()::date
            )
        $$,
        'Account -11111: no previous report exists yet'
    );

    SELECT results_eq(
        $$
            SELECT reconciliation__new_report(
                test_get_account_id('-11111'),
                100, '1001-01-01', FALSE,
                currval('workflow_seq')
            )
        $$,
        $$ SELECT id::bigint + 1 FROM test_parameters $$,
        'Account -11111: creating a report returns baseline id + 1'
    );

    SELECT results_eq(
        $$
            SELECT reconciliation__delete_my_report(
                currval('cr_report_id_seq')::int
            )
        $$,
        ARRAY[TRUE],
        'Account -11111: deleting the new report returns TRUE'
    );

    SELECT is_empty(
        $$
            SELECT reconciliation__previous_report_date(
                test_get_account_id('-11111'), now()::date
            )
        $$,
        'Account -11111: deleted report is not returned as a previous report'
    );

    SELECT results_eq(
        $$
            SELECT reconciliation__new_report(
                test_get_account_id('-11111'),
                100, '1001-01-01', FALSE,
                currval('workflow_seq')
            )
        $$,
        $$ SELECT id::bigint + 2 FROM test_parameters $$,
        'Account -11111: re-creating the report returns baseline id + 2'
    );

    SELECT results_eq(
        $$
            SELECT reconciliation__pending_transactions(
                currval('cr_report_id_seq')::int, 110
            ) > 0
        $$,
        ARRAY[TRUE],
        'Account -11111: pending transactions ran (result > 0)'
    );

    SELECT is(
        (
            SELECT count(DISTINCT ac.entry_id)::int
            FROM acc_trans ac
            JOIN cr_report_line_links rll ON ac.entry_id = rll.entry_id
            JOIN cr_report_line rl ON rll.report_line_id = rl.id
            WHERE report_id = currval('cr_report_id_seq')::int
        ),
        11,
        'Account -11111: 11 distinct journal lines in the report'
    );

    SELECT is(
        (
            SELECT count(*)::int
            FROM cr_report_line
            WHERE scn LIKE '% gl %'
            AND report_id = currval('cr_report_id_seq')::int
        ),
        2,
        'Account -11111: report has 2 GL groups'
    );

    -- "3 sources (1,2,t gl 1) x 2 dates" == 6 transactions
    SELECT is(
        (
            SELECT count(*)::int
            FROM cr_report_line
            WHERE report_id = currval('cr_report_id_seq')::int
        ),
        6,
        'Account -11111: report has 6 lines'
    );

    -- ======================================================================
    -- Account -11111: submit and approve the report
    -- ======================================================================

    -- ---- Fixtures --------------------------------------------------------

    -- Action (not an assertion): save all lines of the current report.
    SELECT reconciliation__save_set(
        currval('cr_report_id_seq')::int,
        (
            SELECT array_agg(id::int)
            FROM cr_report_line
            WHERE report_id = currval('cr_report_id_seq')::int
        )
    );

    -- ---- Tests -----------------------------------------------------------

    SELECT results_eq(
        $$
            SELECT reconciliation__submit_set(
                currval('cr_report_id_seq')::int
            )
        $$,
        ARRAY[TRUE],
        'Account -11111: submitting the saved set returns TRUE'
    );

    SELECT is_empty(
        $$
            SELECT reconciliation__previous_report_date(
                test_get_account_id('-11111'), '1001-01-01'
            )
        $$,
        'Account -11111: no previous report before 1001-01-01'
    );

    SELECT results_eq(
        $$
            SELECT reconciliation__report_approve(
                currval('cr_report_id_seq')::int
            ) > 0
        $$,
        ARRAY[TRUE],
        'Account -11111: approving the report returns a positive value'
    );

    SELECT results_eq(
        $$
            SELECT end_date
            FROM reconciliation__previous_report_date(
                test_get_account_id('-11111'), '1001-01-02'
            )
        $$,
        ARRAY['1001-01-01']::date[],
        'Account -11111: previous report as of 1001-01-02 ends 1001-01-01'
    );

    SELECT is(
        (
            SELECT count(*)::int
            FROM acc_trans
            JOIN account a ON (acc_trans.chart_id = a.id)
            WHERE a.accno = '-11111'
            AND NOT cleared
        ),
        2,
        'Account -11111: 2 uncleared transactions after approval'
    );

    -- ======================================================================
    -- Account -11112: first report, before approving transaction -214
    -- ======================================================================

    -- all items on account -11112 are part of the same payment AR payment,
    --   except a few GL items, some of which have the same source and
    --   transdate == payment_date
    --   and a few others which have the same source but
    --   transdate != payment_date

    -- ---- Tests -----------------------------------------------------------

    SELECT results_eq(
        $$
            SELECT reconciliation__new_report(
                test_get_account_id('-11112'),
                100, now()::date, FALSE,
                currval('workflow_seq')
            ) > 0
        $$,
        ARRAY[TRUE],
        'Account -11112: first report is created (result > 0)'
    );

    SELECT results_eq(
        $$
            SELECT reconciliation__pending_transactions(
                currval('cr_report_id_seq')::int, 110
            ) > 0
        $$,
        ARRAY[TRUE],
        'Account -11112: pending transactions ran (result > 0)'
    );

    SELECT is(
        ARRAY(
            SELECT our_balance
            FROM cr_report_line
            WHERE report_id = currval('cr_report_id_seq')
            ORDER BY our_balance
        ),
        ARRAY[20, 90]::numeric[],
        'Account -11112: two lines with balances 20 (GL) and 90 (payments)'
    );

    SELECT is(
        (
            SELECT count(DISTINCT ac.entry_id)::int
            FROM acc_trans ac
            JOIN cr_report_line_links rll ON ac.entry_id = rll.entry_id
            JOIN cr_report_line rl ON rll.report_line_id = rl.id
            WHERE report_id = currval('cr_report_id_seq')::int
        ),
        11,
        'Account -11112: 11 distinct journal lines in the report'
    );

    -- ======================================================================
    -- Account -11112: first report after approving transaction -214
    -- ======================================================================

    -- ---- Fixtures --------------------------------------------------------

    -- Approve transaction -214 and its acc_trans rows on account -11112.
    UPDATE transactions
    SET approved = TRUE
    WHERE id = -214;

    UPDATE acc_trans
    SET approved = TRUE
    WHERE trans_id = -214
    AND chart_id = test_get_account_id('-11112');

--    select reconciliation__pending_transactions

    -- ---- Tests -----------------------------------------------------------

    SELECT results_eq(
        $$
            SELECT reconciliation__pending_transactions(
                currval('cr_report_id_seq')::int, 110
            )
        $$,
        $$ SELECT id + 3 FROM test_parameters $$,
        'Account -11112: pending transactions return baseline id + 3'
    );

    SELECT is(
        (
            SELECT count(DISTINCT ac.entry_id)::int
            FROM acc_trans ac
            JOIN cr_report_line_links rll ON ac.entry_id = rll.entry_id
            JOIN cr_report_line rl ON rll.report_line_id = rl.id
            WHERE report_id = currval('cr_report_id_seq')::int
        ),
        12,
        'Account -11112: 12 distinct journal lines after approving -214'
    );

    -- 1 payment, with GL adjustment and two GL lines with the same source
    -- (but different date) == 2
    SELECT is(
        (
            SELECT count(*)::int
            FROM cr_report_line
            WHERE report_id = currval('cr_report_id_seq')::int
        ),
        2,
        'Account -11112: report has 2 lines after approving -214'
    );

    SELECT results_eq(
        $$
            SELECT reconciliation__submit_set(
                currval('cr_report_id_seq')::int
            )
        $$,
        ARRAY[TRUE],
        'Account -11112: submitting the report returns TRUE'
    );

    SELECT results_eq(
        $$
            SELECT reconciliation__get_cleared_balance(
                test_get_account_id('-11112')
            )
        $$,
        ARRAY[-10]::numeric[],
        'Account -11112: cleared balance is -10 before report approval'
    );

    SELECT results_eq(
        $$
            SELECT reconciliation__report_approve(
                currval('cr_report_id_seq')::int
            ) > 0
        $$,
        ARRAY[TRUE],
        'Account -11112: approving the report returns a positive value'
    );

    SELECT is(
        (
            SELECT count(*)::int
            FROM acc_trans
            JOIN account ON (acc_trans.chart_id = account.id)
            WHERE accno = '-11112'
            AND NOT cleared
        ),
        13,
        'Account -11112: 13 uncleared transactions after approval'
    );

    SELECT results_eq(
        $$
            SELECT reconciliation__get_cleared_balance(
                test_get_account_id('-11112')
            ) = -10
        $$,
        ARRAY[TRUE],
        'Account -11112: cleared balance is -10 after report approval'
    );

    -- ======================================================================
    -- Account -11112: second report
    -- ======================================================================

    -- ---- Tests -----------------------------------------------------------

    SELECT results_eq(
        $$
            SELECT reconciliation__new_report(
                test_get_account_id('-11112'),
                100, now()::date, FALSE,
                currval('workflow_seq')
            )
        $$,
        $$ SELECT id::bigint + 4 FROM test_parameters $$,
        'Account -11112: second report is created with baseline id + 4'
    );

    SELECT results_eq(
        $$
            SELECT reconciliation__pending_transactions(
                currval('cr_report_id_seq')::int, 110
            )
        $$,
        $$ SELECT id + 4 FROM test_parameters $$,
        'Account -11112: second report pending returns baseline id + 4'
    );

    -- 1 payment, with GL adjustment and two GL lines with the same source
    -- (but different date) == 2
    SELECT is(
        (
            SELECT count(*)::int
            FROM cr_report_line
            WHERE report_id = currval('cr_report_id_seq')::int
        ),
        2,
        'Account -11112: second report has 2 lines'
    );

    -- 1 payment
    SELECT is(
        (
            SELECT count(DISTINCT ac.entry_id)::int
            FROM acc_trans ac
            JOIN cr_report_line_links rll ON ac.entry_id = rll.entry_id
            JOIN cr_report_line rl ON rll.report_line_id = rl.id
            WHERE report_id = currval('cr_report_id_seq')::int
        ),
        12,
        'Account -11112: 12 distinct journal lines in the second report'
    );

    -- ======================================================================
    -- Account -11112: submit and approve the second report
    -- ======================================================================

    -- ---- Fixtures --------------------------------------------------------

    -- Action (not an assertion): save all lines of the current report.
    SELECT reconciliation__save_set(
        currval('cr_report_id_seq')::int,
        (
            SELECT array_agg(id::int)
            FROM cr_report_line
            WHERE report_id = currval('cr_report_id_seq')::int
        )
    );

    -- ---- Tests -----------------------------------------------------------

    SELECT results_eq(
        $$
            SELECT reconciliation__submit_set(
                currval('cr_report_id_seq')::int
            )
        $$,
        ARRAY[TRUE],
        'Account -11112: submitting the second report returns TRUE'
    );

    SELECT results_eq(
        $$
            SELECT their_total::int
            FROM reconciliation__report_summary(
                currval('cr_report_id_seq')::int
            )
        $$,
        ARRAY[110],
        'Account -11112: second report summary their_total is 110'
    );

    SELECT results_eq(
        $$
            SELECT reconciliation__get_cleared_balance(
                test_get_account_id('-11112')
            ) = -10
        $$,
        ARRAY[TRUE],
        'Account -11112: cleared balance is -10 before second approval'
    );

    SELECT results_eq(
        $$
            SELECT reconciliation__report_approve(
                currval('cr_report_id_seq')::int
            ) > 0
        $$,
        ARRAY[TRUE],
        'Account -11112: approving the second report returns a positive value'
    );

    -- Should we throw an exception?
    SELECT results_eq(
        $$
            SELECT reconciliation__delete_my_report(
                currval('cr_report_id_seq')::int
            ) IS NULL
        $$,
        ARRAY[TRUE],
        'Account -11112: approved report cannot be deleted (returns NULL)'
    );

    SELECT is(
        (
            SELECT count(*)::int
            FROM acc_trans
            JOIN account a ON (acc_trans.chart_id = a.id)
            WHERE accno = '-11112'
            AND NOT cleared
        ),
        1,
        'Account -11112: 1 uncleared transaction after second approval'
    );

    SELECT results_eq(
        $$
            SELECT reconciliation__get_cleared_balance(
                test_get_account_id('-11112')
            )
        $$,
        ARRAY[-130]::numeric[],
        'Account -11112: cleared balance is -130 after second approval'
    );

    -- ======================================================================
    -- Account -11113: GL item shared by two payments
    -- ======================================================================

    -- there are 3 items on account -11113, 2 are part of one payment each,
    --   the third is a GL transaction
    --   all have the same 'source' value, which means that the GL entry will
    --   be considered a correction to *both* payments. Because that's
    --   ambiguous, the GL item should be presented as a separate recon
    --   line instead.

    -- ---- Tests -----------------------------------------------------------

    SELECT results_eq(
        $$
            SELECT reconciliation__new_report(
                test_get_account_id('-11113'),
                100, now()::date, FALSE,
                currval('workflow_seq')
            ) > 0
        $$,
        ARRAY[TRUE],
        'Account -11113: report is created (result > 0)'
    );

    SELECT results_eq(
        $$
            SELECT reconciliation__pending_transactions(
                currval('cr_report_id_seq')::int, 110
            ) > 0
        $$,
        ARRAY[TRUE],
        'Account -11113: pending transactions ran (result > 0)'
    );

    -- ======================================================================
    -- Finish
    -- ======================================================================

    -- Finish the tests and clean up.
    SELECT * FROM finish();

ROLLBACK;
