BEGIN;
    -- Load the TAP functions.
    CREATE EXTENSION pgtap;
    SET client_min_messages TO warning;

    -- Plan the tests.

    SELECT plan(40);

    -- ======================================================================
    -- Setup
    -- ======================================================================

    -- Add data

    \i xt/data/42-pg/Base.sql
    \i xt/data/42-pg/Assets.sql

    -- Asset report type ids, used by the fixtures further down

    \set asset_report_type_depreciation 1
    \set asset_report_type_full_disposal 2
    \set asset_report_type_partial_disposal 4

    -- ======================================================================
    -- Required database objects
    -- ======================================================================

    -- Fixtures: none (uses only the data loaded in Setup)

    -- Tests

    -- Validate required tables

--    SELECT has_table('business');

    -- Validate required functions

    SELECT has_function(t.func_name, t.arg_types)
      FROM (VALUES
        ('asset_dep__straight_line_base',
         ARRAY['numeric', 'numeric', 'numeric', 'numeric']),
        ('asset_dep__used_months',
         ARRAY['date', 'date', 'numeric']),
        ('asset_dep_get_usable_life_yr',
         ARRAY['numeric', 'date', 'date']),
        ('months_passed',
         ARRAY['timestamp without time zone',
               'timestamp without time zone']),
        ('asset_dep_straight_line_yr_d',
         ARRAY['integer[]', 'date', 'integer']),
        ('asset_dep_straight_line_yr_m',
         ARRAY['integer[]', 'date', 'integer']),
        ('asset_dep_straight_line_month',
         ARRAY['integer[]', 'date', 'integer']),
        ('asset_report__generate_gl',
         ARRAY['integer', 'integer']),
        ('asset_class__get',
         ARRAY['integer']),
        ('asset_class__search',
         ARRAY['integer', 'integer', 'integer', 'text']),
        ('asset_class__get_dep_methods',
         '{}'::text[]),
        ('asset_class__save',
         ARRAY['integer', 'integer', 'integer', 'integer', 'text', 'text']),
        ('asset__get',
         ARRAY['integer', 'text']),
        ('asset__search',
         ARRAY['integer', 'text', 'text', 'date', 'numeric', 'numeric',
               'numeric']),
        ('asset_class__get_asset_accounts',
         '{}'::text[]),
        ('asset_class__get_dep_accounts',
         '{}'::text[]),
        ('asset__save',
         ARRAY['integer', 'integer', 'text', 'text', 'date', 'numeric',
               'numeric', 'numeric', 'date', 'integer', 'integer', 'integer',
               'integer', 'integer', 'integer', 'integer']),
        ('asset_item__search',
         ARRAY['integer', 'integer', 'text', 'text', 'date', 'numeric',
               'numeric', 'numeric', 'date', 'integer', 'integer',
               'integer', 'integer', 'integer']),
        ('asset_class__get_dep_method',
         ARRAY['integer']),
        ('asset_report__save',
         ARRAY['integer', 'date', 'integer', 'integer', 'boolean']),
        ('asset_report__dispose',
         ARRAY['integer', 'integer', 'numeric', 'integer', 'numeric']),
        ('asset_report__get_disposal',
         ARRAY['integer']),
        ('asset_nbv_report',
         '{}'::text[]),
        ('asset_report_partial_disposal_details',
         ARRAY['integer']),
        ('asset_report__approve',
         ARRAY['integer', 'integer', 'integer', 'integer', 'integer']),
        ('asset_report__disposal_gl',
         ARRAY['integer', 'integer', 'integer', 'integer']),
        ('asset_item__add_note',
         ARRAY['integer', 'text', 'text']),
        ('asset_report__get_expense_accts',
         '{}'::text[]),
        ('asset_report__get_gain_accts',
         '{}'::text[]),
        ('asset_report__get_loss_accts',
         '{}'::text[]),
        ('asset_report__get_cash_accts',
         '{}'::text[]),
        ('asset_report__get',
         ARRAY['integer']),
        ('asset_report__get_lines',
         ARRAY['integer']),
        ('asset_report__search',
         ARRAY['date', 'date', 'integer', 'boolean', 'integer']),
        ('asset_report__generate',
         ARRAY['boolean', 'integer', 'date']),
        ('asset_report__begin_import',
         ARRAY['integer', 'date']),
        ('asset_report__import',
         ARRAY['text', 'text', 'numeric', 'numeric', 'numeric', 'date',
               'date', 'integer', 'integer', 'integer', 'integer', 'integer',
               'integer', 'integer', 'integer', 'numeric', 'boolean']),
        ('asset_report__begin_disposal',
         ARRAY['integer', 'date', 'integer']),
        ('asset_report__record_approve',
         ARRAY['integer']),
        ('asset__import_from_disposal',
         ARRAY['integer'])
      ) AS t(func_name, arg_types);

    -- ======================================================================
    -- Asset lifecycle: depreciation, partial disposal, full disposal
    -- ======================================================================

    -- Fixtures

    -- Set up asset class

    SELECT __create_fixed_asset_account() AS asset_acc_id
    \gset
    SELECT __create_asset_dep_account() AS dep_acc_id
    \gset
    SELECT __create_asset_loss_account() AS loss_acc_id
    \gset
    SELECT __create_asset_gain_account() AS gain_acc_id
    \gset
    SELECT asset_class__save(
        NULL,                           -- id (guess)
        :asset_acc_id,                  -- asset account id (guess)
        :dep_acc_id,                    -- depreciation account id (guess)
        (SELECT id FROM asset_dep_method
          WHERE method = 'Annual Straight Line Monthly'),  -- method id (guess)
        'new asset class',              -- name (guess)
        'unit label'                    -- label (guess)
    ) AS new_class
    \gset

    -- Create asset

    SELECT __create_asset_exp_account() AS exp_acc_id
    \gset
    SELECT asset__save(
        NULL,                           -- id (guess)
        (:'new_class'::asset_class).id, -- asset class id (guess)
        'new asset',                    -- description (guess)
        'tag of new asset',             -- tag (guess)
        '2010-10-01'::date,             -- purchase date (guess)
        4800,                           -- purchase value (guess)
        3,                              -- usable life in years (guess)
        1200,                           -- salvage value (guess)
        '2010-10-01'::date,             -- depreciation start date (guess)
        NULL,                           -- integer arg, purpose unknown
        NULL,                           -- integer arg, purpose unknown
        NULL,                           -- integer arg, purpose unknown
        :asset_acc_id,                  -- asset account id (guess)
        :dep_acc_id,                    -- depreciation account id (guess)
        :exp_acc_id,                    -- expense account id (guess)
        NULL                            -- integer arg, purpose unknown
    ) AS new_asset
    \gset

    -- Run depreciation

    SELECT asset_report__save(
        NULL,                            -- id (guess)
        '2010-11-01'::date,              -- report date (guess)
        :asset_report_type_depreciation, -- report type id (guess)
        (:'new_class'::asset_class).id,  -- asset class id (guess)
        TRUE                             -- boolean flag, purpose unknown
    ) AS new_report
    \gset
    SELECT asset_report__approve(
        (:'new_report'::asset_report).id, -- report id (guess)
        :exp_acc_id,                      -- expense account id (guess)
        NULL,                             -- gain account id (guess)
        NULL,                             -- loss account id (guess)
        NULL                              -- integer arg, purpose unknown
    ) AS approved_report
    \gset

    -- Run partial disposal (abandonment)

    SELECT asset_report__save(
        NULL,                               -- id (guess)
        '2010-11-01'::date,                 -- report date (guess)
        :asset_report_type_partial_disposal, -- report type id (guess)
        (:'new_class'::asset_class).id,     -- asset class id (guess)
        TRUE                                -- boolean flag, purpose unknown
    ) AS disposal_report
    \gset
    SELECT asset_report__dispose(
        (:'disposal_report'::asset_report).id, -- report id (guess)
        (:'new_asset'::asset_item).id,         -- asset item id (guess)
        0.00,                                  -- proceeds (guess)
        (SELECT id FROM asset_disposal_method
          WHERE short_label = 'A'),            -- method id (guess)
        50                                     -- percent disposed (guess)
    );
    SELECT asset_report__approve(
        (:'disposal_report'::asset_report).id, -- report id (guess)
        :exp_acc_id,                           -- expense account id (guess)
        :gain_acc_id,                          -- gain account id (guess)
        :loss_acc_id,                          -- loss account id (guess)
        NULL                                   -- integer arg, purpose unknown
    ) AS approved_report
    \gset

    -- Run full disposal (abandonment)

    SELECT asset_report__save(
        NULL,                            -- id (guess)
        '2010-11-01'::date,              -- report date (guess)
        :asset_report_type_full_disposal, -- report type id (guess)
        (:'new_class'::asset_class).id,  -- asset class id (guess)
        TRUE                             -- boolean flag, purpose unknown
    ) AS full_disposal_report
    \gset
    SELECT asset_report__dispose(
        (:'full_disposal_report'::asset_report).id, -- report id (guess)
        (:'new_asset'::asset_item).id,              -- asset item id (guess)
        0.00,                                       -- proceeds (guess)
        (SELECT id FROM asset_disposal_method
          WHERE short_label = 'A'),                 -- method id (guess)
        100                                         -- percent disposed (guess)
    );
    SELECT asset_report__approve(
        (:'disposal_report'::asset_report).id, -- report id (guess)
        :exp_acc_id,                           -- expense account id (guess)
        :gain_acc_id,                          -- gain account id (guess)
        :loss_acc_id,                          -- loss account id (guess)
        NULL                                   -- integer arg, purpose unknown
    ) AS approved_report
    \gset

    -- Tests

    -- TODO: Verify results on various reports (depreciation, partial/full disposal)

--    PREPARE test AS select ...;
--    SELECT results_eq('test',result,'Description');
--    DEALLOCATE test;

    -- Finish the tests and clean up.
    SELECT * FROM finish();

ROLLBACK;
