BEGIN;
    -- ========================================================================
    -- Setup
    -- ========================================================================

    -- Load the TAP functions.
    CREATE EXTENSION pgtap;
    SET client_min_messages TO warning;

    -- Plan the tests.
    SELECT plan(65);

    -- Add data
    \i xt/data/42-pg/Company.sql

    -- Id legend:
    --   * -100 and -101 are the first column of the expected contact__search
    --     rows below. They are not created in this file; they must be supplied
    --     by the include above or by the schema.
    --   * Every other id comes from sequences (currval(...)) and is not fixed.
    --   * Tests below are order-sensitive: later sections read currval(...)
    --     values set by earlier ones, so keep the sections in this order.

    -- ========================================================================
    -- Schema: required tables and functions
    -- ========================================================================

    -- Fixtures: none.

    -- Tests: required tables
    SELECT has_table('company');
    SELECT has_table('person_to_company');

    -- Tests: required functions (one row per function; default descriptions)
    SELECT has_function(t.func_name, t.arg_types)
    FROM (
        VALUES
            ('account__all_headings', '{}'::text[]),
            ('company_get_billing_info', ARRAY['integer']),
            ('company__get_by_cc', ARRAY['text']),
            ('company__get', ARRAY['integer']),
            ('company__next_id', '{}'::text[]),
            ('company__save',
             ARRAY['text', 'text', 'text', 'integer', 'text', 'integer', 'text',
                   'text']),
            ('contact_class__list', '{}'::text[]),
            ('contact__search',
             ARRAY['integer', 'text', 'text[]', 'text', 'text', 'text', 'text',
                   'text', 'text', 'date', 'date', 'integer', 'text', 'text',
                   'text', 'boolean']),
            ('eca__delete_contact', ARRAY['integer', 'integer', 'text']),
            ('eca__delete_location', ARRAY['integer', 'integer', 'integer']),
            ('eca__delete_pricematrix', ARRAY['integer', 'integer']),
            ('eca__get_by_meta_number', ARRAY['text', 'integer']),
            ('eca__get_pricematrix_by_pricegroup', ARRAY['integer']),
            ('eca__get_pricematrix', ARRAY['integer']),
            ('eca__get_taxes', ARRAY['integer']),
            ('eca__history',
             ARRAY['text', 'text', 'text', 'text', 'text', 'text', 'text',
                   'text', 'text', 'integer', 'date', 'date', 'character',
                   'date', 'date', 'integer', 'boolean', 'boolean']),
            ('eca__history_summary',
             ARRAY['text', 'text', 'text', 'text', 'text', 'text', 'text',
                   'text', 'text', 'integer', 'date', 'date', 'character',
                   'date', 'date', 'integer', 'boolean', 'boolean']),
            ('eca__list_contacts', ARRAY['integer']),
            ('eca__list_locations', ARRAY['integer']),
            ('eca__list_notes', ARRAY['integer']),
            ('eca__save',
             ARRAY['integer', 'integer', 'integer', 'text', 'numeric',
                   'boolean', 'numeric', 'integer', 'integer',
                   'character varying', 'integer', 'character varying',
                   'integer', 'character', 'date', 'date', 'numeric', 'integer',
                   'integer', 'text', 'integer', 'integer']),
            ('eca__save_contact',
             ARRAY['integer', 'integer', 'text', 'text', 'text', 'integer']),
            ('eca__save_notes', ARRAY['integer', 'text', 'text']),
            ('eca__save_pricematrix',
             ARRAY['integer', 'integer', 'numeric', 'numeric', 'smallint',
                   'text', 'date', 'date', 'character', 'integer']),
            ('eca__set_taxes', ARRAY['integer', 'integer[]']),
            ('entity_credit__get', ARRAY['integer']),
            ('entity_credit_get_id', ARRAY['integer', 'integer', 'text']),
            ('entity_credit_get_id_by_meta_number', ARRAY['text', 'integer']),
            ('entity__delete_contact', ARRAY['integer', 'integer', 'text']),
            ('entity__delete_location', ARRAY['integer', 'integer', 'integer']),
            ('entity__list_bank_account', ARRAY['integer']),
            ('entity__list_contacts', ARRAY['integer']),
            ('entity__list_credit', ARRAY['integer', 'integer']),
            ('entity__list_locations', ARRAY['integer']),
            ('entity__list_notes', ARRAY['integer']),
            ('_entity_location_save',
             ARRAY['integer', 'integer', 'integer', 'text', 'text', 'text',
                   'text', 'text', 'text', 'integer']),
            ('entity__location_save',
             ARRAY['integer', 'integer', 'integer', 'text', 'text', 'text',
                   'text', 'text', 'text', 'integer', 'date']),
            ('entity__save_bank_account',
             ARRAY['integer', 'integer', 'text', 'text', 'text', 'integer']),
            ('entity__save_contact',
             ARRAY['integer', 'integer', 'text', 'text', 'text', 'integer']),
            ('entity__save_notes', ARRAY['integer', 'text', 'text']),
            ('list_taxforms', ARRAY['integer']),
            ('pricegroup__list', '{}'::text[]),
            ('sic__list', '{}'::text[])
    ) AS t(func_name, arg_types);

    -- ========================================================================
    -- Company and credit account
    -- ========================================================================

    -- Fixtures
    INSERT INTO sic (code, description)
    VALUES ('1234', '1234 Desc');

    -- Tests
    SELECT ok(
        company__save(
            'TESTING...', 'TESTING', 'TESTING', NULL, '1234',
            232, 'st-123', 'ubi-123-456-789'
        ) IS NOT NULL,
        'company__save returns a non-NULL result'
    );

    -- Order-sensitive: relies on currval('entity_id_seq') set earlier.
    SELECT ok(
        eca__save(
            NULL, 1, currval('entity_id_seq')::int, 'TEST', 0, FALSE,
            0, 0, 0, 'test-123', NULL, NULL, NULL, 'XTS',
            now()::date, now()::date,
            0, -1000, NULL, NULL, NULL, NULL
        ) IS NOT NULL,
        'eca__save returns a non-NULL result (credit account)'
    );

    -- ========================================================================
    -- Credit account locations
    -- ========================================================================

    -- Fixtures: none (uses the credit account saved above).

    -- Tests
    -- Order-sensitive: relies on currval('entity_credit_account_id_seq').
    SELECT ok(
        eca__location_save(
            currval('entity_credit_account_id_seq')::int,
            NULL, 2, 'Test', 'Test',
            NULL, 'Test', 'Test', '12345', 25, NULL
        ) IS NOT NULL,
        'eca__location_save returns a non-NULL result'
    );

    SELECT ok(
        eca__location_save(
            currval('entity_credit_account_id_seq')::int,
            NULL, 1, 'Test2', 'Test',
            '', 'Test', 'Test123', '12345', 25, NULL
        ) = eca__location_save(
            currval('entity_credit_account_id_seq')::int,
            NULL, 3, 'Test2', 'Test',
            '', 'Test', 'Test123', '12345', 25, NULL
        ),
        'eca__location_save returns the same id for calls differing only in '
        '1 vs 3, with no in_location_id'
    );

    SELECT ok(
        (SELECT count(*) = 3
           FROM eca__list_locations(
               currval('entity_credit_account_id_seq')::int)),
        'eca__list_locations returns 3 rows'
    );

    -- ========================================================================
    -- Credit account contacts
    -- ========================================================================

    -- Fixtures: none (uses the credit account saved above).

    -- Tests
    SELECT ok(
        eca__save_contact(
            currval('entity_credit_account_id_seq')::int,
            1, 'test_d', 'test_c', NULL, NULL
        ) IS NOT NULL,
        'eca__save_contact returns a non-NULL result'
    );

    SELECT ok(
        (SELECT count(*) = 1
           FROM eca__list_contacts(
               currval('entity_credit_account_id_seq')::int)
          WHERE contact = 'test_c'),
        'eca__list_contacts finds exactly one contact test_c'
    );

    -- ========================================================================
    -- Billing info
    -- ========================================================================

    -- Fixtures: none (uses the highest entity_credit_account id).

    -- Tests
    SELECT ok(
        (SELECT count(*) = 1
           FROM company_get_billing_info(
               (SELECT max(id) FROM entity_credit_account))
          WHERE control_code IS NOT NULL),
        'company_get_billing_info returns one row with a control code '
        'for the highest credit account id'
    );

    -- ========================================================================
    -- Notes
    -- ========================================================================

    -- Fixtures: none (uses the entity and credit account saved above).

    -- Tests
    SELECT ok(
        entity__save_notes(
            currval('entity_id_seq')::int,
            'Test note text', 'Test note subject'
        ) IS NOT NULL,
        'entity__save_notes returns a non-NULL result'
    );

    SELECT results_eq(
        $$ SELECT CASE WHEN subject = 'Test note subject'
                       THEN TRUE ELSE FALSE END
             FROM entity_note
            WHERE id = currval('entity_note_id_seq') $$,
        ARRAY[TRUE],
        'entity__save_notes stored the expected subject'
    );

    SELECT ok(
        eca__save_notes(
            currval('entity_credit_account_id_seq')::int,
            'Test note text', 'ECA test note subject'
        ) IS NOT NULL,
        'eca__save_notes returns a non-NULL result'
    );

    SELECT results_eq(
        $$ SELECT CASE WHEN subject = 'ECA test note subject'
                       THEN TRUE ELSE FALSE END
             FROM eca_note
            WHERE id = currval('eca_note_id_seq') $$,
        ARRAY[TRUE],
        'eca__save_notes stored the expected subject'
    );

    -- ========================================================================
    -- Contact search
    -- ========================================================================

    -- Fixtures: none (rows -100 and -101 come from the include; see legend).

    -- Tests
    -- Each case calls contact__search with all 16 arguments NULL except the
    -- one at arg_pos, which is set to arg_value, and expects exactly one full
    -- row. Row order below is the execution order (no ORDER BY on purpose).
    SELECT results_eq(
        format(
            'SELECT * FROM contact__search(%s)',
            (SELECT string_agg(
                        CASE WHEN g.n = t.arg_pos
                             THEN quote_literal(t.arg_value)
                             ELSE 'NULL'
                        END,
                        ', ' ORDER BY g.n)
               FROM generate_series(1, 16) AS g(n))
        ),
        format(
            $$ VALUES (%s, %L, NULL::integer, NULL::text, NULL::text,
                       NULL::integer, %L, NULL::text, NULL::text,
                       NULL::text) $$,
            t.expected_id, t.expected_ctrl, t.expected_name
        ),
        t.description
    )
    FROM (
        VALUES
            ('contact__search finds person by name',
             13, 'User', -100, '_TESTING.....', 'Test User'),
            ('contact__search finds company by name',
             13, 'Test Company', -101, '_TEST2', 'Test Company'),
            ('contact__search finds company by city',
             6, 'Cityville', -101, '_TEST2', 'Test Company'),
            ('contact__search finds company by state',
             7, 'Statington', -101, '_TEST2', 'Test Company'),
            ('contact__search finds company by mail code',
             8, 'AB1234', -101, '_TEST2', 'Test Company'),
            ('contact__search finds company by control code',
             14, '_TEST2', -101, '_TEST2', 'Test Company'),
            ('contact__search finds company by address',
             5, '101 Main', -101, '_TEST2', 'Test Company'),
            ('contact__search finds company by country',
             9, 'CA', -101, '_TEST2', 'Test Company')
    ) AS t(description, arg_pos, arg_value,
           expected_id, expected_ctrl, expected_name);

    -- ========================================================================
    -- Finish
    -- ========================================================================

    -- Finish the tests and clean up.
    SELECT * FROM finish();

ROLLBACK;
