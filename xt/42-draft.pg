BEGIN;
    -- ======================================================================
    -- Setup
    -- ======================================================================

    -- Load the TAP functions.
    CREATE EXTENSION pgtap;
    SET client_min_messages TO warning;

    -- Plan the tests.
    SELECT plan(20);

    -- Add data
    \i xt/data/42-pg/Base.sql

    -- Id legend (all explicit ids in this file are negative):
    --   -1000  entity '__TEST'. The same value is also used as the id of
    --          entity_credit_account '_testv', as that account's entity_id,
    --          and as ar_ap_account_id on both credit accounts. The account
    --          with id -1000 is not created in this file (assumed to come
    --          from Base.sql or the schema).
    --   -1001  entity_credit_account '_testc' (belongs to entity -1000).
    --   243    entity.country_id (not created in this file).
    --   Ids of transactions, open_item and acc_trans rows are generated by
    --   sequences and read back with currval(...).

    -- ======================================================================
    -- Schema checks
    -- ======================================================================

    -- ---- Tests ----

    -- Required tables
    SELECT has_table(t.table_name)
    FROM (VALUES
        ('acc_trans'::name),
        ('ac_tax_form'::name),
        ('ap'::name),
        ('ar'::name),
        ('entity_credit_account'::name),
        ('entity'::name),
        ('gl'::name)
    ) AS t(table_name);

    -- Required functions
    SELECT has_function(t.function_name, t.argument_types)
    FROM (VALUES
        ('draft__search'::name,
         ARRAY['text', 'text', 'date', 'date', 'numeric', 'numeric']::name[]),
        ('draft_approve'::name, ARRAY['integer']::name[]),
        ('draft_delete'::name, ARRAY['integer']::name[])
    ) AS t(function_name, argument_types);

    -- ======================================================================
    -- Draft search and delete
    -- ======================================================================

    -- ---- Fixtures ----

    -- Helper: _test_add_acc_trans(accno, amount) returns void. It inserts one
    -- approved acc_trans row (currency 'XTS', amount_bc = amount_tc = amount)
    -- for the account with that accno, on the transaction most recently
    -- created in this session (currval('transactions_id_seq')).
    -- Defined here, after the schema checks, so that a missing table makes
    -- those checks fail instead of aborting the transaction at this point.
    CREATE FUNCTION _test_add_acc_trans(p_accno TEXT, p_amount NUMERIC)
    RETURNS VOID AS $$
        INSERT INTO acc_trans
            (chart_id, trans_id, amount_bc, curr, amount_tc, approved)
        SELECT id, currval('transactions_id_seq'),
               p_amount, 'XTS', p_amount, TRUE
        FROM account
        WHERE accno = p_accno;
    $$ LANGUAGE SQL;

    -- Shared: entity and its two credit accounts
    INSERT INTO entity
        (id, name, country_id)
    VALUES
        (-1000, '__TEST', 243);

    INSERT INTO entity_credit_account
        (id, meta_number, entity_class, entity_id, ar_ap_account_id, curr)
    VALUES
        (-1000, '_testv', 1, -1000, -1000, 'XTS');
    INSERT INTO entity_credit_account
        (id, meta_number, entity_class, entity_id, ar_ap_account_id, curr)
    VALUES
        (-1001, '_testc', 2, -1000, -1000, 'XTS');

    -- Shared: accounts 00001 and 00002
    SELECT account__save(
        NULL, '00001', 'test only', 'A', NULL,
        (SELECT id FROM account_heading LIMIT 1), NULL, FALSE, FALSE, '{}',
        FALSE, FALSE, FALSE
    );
    SELECT account__save(
        NULL, '00002', 'test only', 'A', NULL,
        (SELECT id FROM account_heading LIMIT 1), NULL, FALSE, FALSE, '{}',
        FALSE, FALSE, FALSE
    );

    -- AP draft (_TEST AP), with ac_tax_form rows
    INSERT INTO transactions
        (reference, transdate, trans_type_code, approved)
    VALUES
        ('_TEST AP', now(), 'ap', FALSE);
    INSERT INTO open_item
        (item_number, item_type, account_id)
    VALUES
        ('_TEST AP', 'ap', (SELECT id FROM account WHERE accno = '00001'));
    INSERT INTO ap
        (trans_id, open_item_id,
         invnumber, entity_credit_account,
         amount_bc, netamount_bc, amount_tc, netamount_tc, curr)
    SELECT
        currval('transactions_id_seq'), currval('open_item_id_seq'),
        '_TEST AP', -1000,
        100, 100, 100, 100, 'XTS';

    SELECT _test_add_acc_trans('00001', 100);
    INSERT INTO ac_tax_form
        (entry_id, reportable)
    VALUES
        (currval('acc_trans_entry_id_seq')::int, TRUE);
    SELECT _test_add_acc_trans('00002', -100);
    INSERT INTO ac_tax_form
        (entry_id, reportable)
    VALUES
        (currval('acc_trans_entry_id_seq')::int, FALSE);

    -- AR draft (_TEST AR)
    INSERT INTO transactions
        (reference, transdate, trans_type_code, approved)
    VALUES
        ('_TEST AR', now(), 'ar', FALSE);
    INSERT INTO open_item
        (item_number, item_type, account_id)
    VALUES
        ('_TEST AR', 'ar', (SELECT id FROM account WHERE accno = '00002'));
    INSERT INTO ar
        (trans_id, open_item_id,
         invnumber, entity_credit_account,
         amount_bc, netamount_bc, amount_tc, netamount_tc, curr)
    SELECT
        currval('transactions_id_seq'), currval('open_item_id_seq'),
        '_TEST AR', -1001,
        100, 100, 100, 100, 'XTS';

    SELECT _test_add_acc_trans('00001', -100);
    SELECT _test_add_acc_trans('00002', 100);

    -- GL draft (_TEST GL). Must stay the last transactions row created:
    -- the tests below read it back with currval('transactions_id_seq').
    INSERT INTO transactions
        (reference, description, transdate, trans_type_code, approved)
    VALUES
        ('_TEST GL', 'Testing GL Drafts', now(), 'gl', FALSE);
    INSERT INTO gl
        (id)
    VALUES
        (currval('transactions_id_seq'));

    SELECT _test_add_acc_trans('00001', -100);
    SELECT _test_add_acc_trans('00002', 100);

    -- ---- Tests ----

    -- Search "ap" / "AP", then delete the AP draft
    SELECT is(
        (SELECT count(*)
         FROM draft__search('ap', NULL, NULL, NULL, NULL, NULL)
         WHERE reference = '_TEST AP'),
        1::bigint,
        'Search "ap" finds the _TEST AP draft'
    );

    SELECT ok(
        (SELECT count(*) = 1
         FROM draft__search('AP', NULL, NULL, NULL, NULL, NULL)
         WHERE reference = '_TEST AP'),
        'Search "AP" finds the _TEST AP draft'
    );

    SELECT results_eq(
        $$
            SELECT draft_delete(id)
            FROM draft__search('AP', NULL, NULL, NULL, NULL, NULL)
            WHERE reference = '_TEST AP'
        $$,
        ARRAY[TRUE],
        'Deleting the _TEST AP draft (with 1099 tax-form rows) succeeds'
    );

    -- Search "ar" / "AR" / "gl" / "GL" (lower and upper case spellings)
    SELECT ok(
        (SELECT count(*) = 1
         FROM draft__search(t.search_arg, NULL, NULL, NULL, NULL, NULL)
         WHERE reference = t.ref),
        t.label
    )
    FROM (VALUES
        ('ar', '_TEST AR', 'Search "ar" finds the _TEST AR draft'),
        ('AR', '_TEST AR', 'Search "AR" finds the _TEST AR draft'),
        ('gl', '_TEST GL', 'Search "gl" finds the _TEST GL draft'),
        ('GL', '_TEST GL', 'Search "GL" finds the _TEST GL draft')
    ) AS t(search_arg, ref, label);

    -- Delete the GL draft and check that its rows are gone
    SELECT results_eq(
        $$ SELECT draft_delete(currval('transactions_id_seq')::int) $$,
        ARRAY[TRUE],
        'Deleting the _TEST GL draft succeeds'
    );

    SELECT is_empty(
        $$
            SELECT 1
            FROM gl
            WHERE id = currval('transactions_id_seq')
        $$,
        'Deleting the GL draft removes its gl row'
    );

    SELECT is_empty(
        $$
            SELECT 1
            FROM acc_trans
            WHERE trans_id = currval('transactions_id_seq')
        $$,
        'Deleting the GL draft removes its acc_trans rows'
    );

    -- ======================================================================
    -- Finish
    -- ======================================================================

    -- Finish the tests and clean up.
    SELECT * FROM finish();

ROLLBACK;
