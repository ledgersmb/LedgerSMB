BEGIN;

    -- ========================================================================
    -- Setup
    -- ========================================================================

    -- Load the TAP functions.
    CREATE EXTENSION pgtap;
    SET client_min_messages TO warning;

    -- Plan the tests.
    SELECT plan(25);

    -- Fixtures: base data (supplies everything not created in this file).
    \i xt/data/42-pg/Base.sql

    -- ========================================================================
    -- Schema: required tables
    -- ========================================================================

    -- Tests (5 assertions: one per row).
    SELECT has_table(
        t.table_name::name,
        format('Table %s should exist', t.table_name)
    )
    FROM (
        VALUES
            ('defaults'),
            ('entity_employee'),
            ('session'),
            ('user_preference'),
            ('users')
    ) AS t(table_name);

    -- ========================================================================
    -- Schema: required views
    -- ========================================================================

    -- Tests (1 assertion).
    SELECT has_view('user_listable', 'View user_listable should exist');

    -- ========================================================================
    -- Schema: required functions
    -- ========================================================================

    -- Tests (18 assertions: one per row).
    SELECT has_function(
        t.function_name::name,
        t.argument_types::name[],
        format(
            'Function %s(%s) should exist',
            t.function_name,
            array_to_string(t.argument_types, ', ')
        )
    )
    FROM (
        VALUES
            ('admin__add_user_to_role', ARRAY['text','text']),
            ('admin__delete_user', ARRAY['text','boolean']),
            ('admin__drop_session', ARRAY['integer']),
            ('admin__get_roles', '{}'::text[]),
            ('admin__get_roles_for_user', ARRAY['integer']),
            ('admin__get_roles_for_user_by_entity', ARRAY['integer']),
            ('admin__get_user', ARRAY['integer']),
            ('admin__get_user_by_entity', ARRAY['integer']),
            ('admin__is_user', ARRAY['text']),
            ('admin__list_sessions', '{}'::text[]),
            ('admin__remove_user_from_role', ARRAY['text','text']),
            ('admin__save_user',
                ARRAY['integer','integer','text','text','boolean']),
            ('admin__search_users',
                ARRAY['text','text','text','text','date']),
            ('user__change_password', ARRAY['text']),
            ('user__check_my_expiration', '{}'::text[]),
            ('user__get_all_users', '{}'::text[]),
            ('user__get_preferences', ARRAY['integer']),
            ('user__save_preferences',
                ARRAY['text','text','text','text','text'])
    ) AS t(function_name, argument_types);

    -- ========================================================================
    -- Admin behaviour (placeholder)
    -- ========================================================================

    -- Tests (1 assertion).
    SELECT ok(TRUE, 'No specific admin tests yet!');

    -- Finish the tests and clean up.
    SELECT * FROM finish();

ROLLBACK;
