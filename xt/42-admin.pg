BEGIN;
   -- Load the TAP functions.
    CREATE EXTENSION pgtap;
    SET client_min_messages TO warning;

   -- Plan the tests.

    SELECT plan(25);

   -- Add data.

    \i xt/data/42-pg/Base.sql

   -- Validate required tables.

    SELECT has_table('defaults', 'Table defaults should exist');
    SELECT has_table('entity_employee', 'Table entity_employee should exist');
    SELECT has_table('session', 'Table session should exist');
    SELECT has_table('user_preference', 'Table user_preference should exist');
    SELECT has_table('users', 'Table users should exist');

   -- Validate required views.

    SELECT has_view('user_listable', 'View user_listable should exist');

   -- Validate required functions.

    SELECT has_function(
        'admin__add_user_to_role', -- function name
        ARRAY['text','text'], -- argument types
        'Function admin__add_user_to_role(text, text) should exist' -- description
    );
    SELECT has_function(
        'admin__delete_user', -- function name
        ARRAY['text','boolean'], -- argument types
        'Function admin__delete_user(text, boolean) should exist' -- description
    );
    SELECT has_function(
        'admin__drop_session', -- function name
        ARRAY['integer'], -- argument types
        'Function admin__drop_session(integer) should exist' -- description
    );
    SELECT has_function(
        'admin__get_roles', -- function name
        '{}'::text[], -- argument types
        'Function admin__get_roles() should exist' -- description
    );
    SELECT has_function(
        'admin__get_roles_for_user', -- function name
        ARRAY['integer'], -- argument types
        'Function admin__get_roles_for_user(integer) should exist' -- description
    );
    SELECT has_function(
        'admin__get_roles_for_user_by_entity', -- function name
        ARRAY['integer'], -- argument types
        'Function admin__get_roles_for_user_by_entity(integer) should exist' -- description
    );
    SELECT has_function(
        'admin__get_user', -- function name
        ARRAY['integer'], -- argument types
        'Function admin__get_user(integer) should exist' -- description
    );
    SELECT has_function(
        'admin__get_user_by_entity', -- function name
        ARRAY['integer'], -- argument types
        'Function admin__get_user_by_entity(integer) should exist' -- description
    );
    SELECT has_function(
        'admin__is_user', -- function name
        ARRAY['text'], -- argument types
        'Function admin__is_user(text) should exist' -- description
    );
    SELECT has_function(
        'admin__list_sessions', -- function name
        '{}'::text[], -- argument types
        'Function admin__list_sessions() should exist' -- description
    );
    SELECT has_function(
        'admin__remove_user_from_role', -- function name
        ARRAY['text','text'], -- argument types
        'Function admin__remove_user_from_role(text, text) should exist' -- description
    );
    SELECT has_function(
        'admin__save_user', -- function name
        ARRAY['integer','integer','text','text','boolean'], -- argument types
        'Function admin__save_user(integer, integer, text, text, boolean) should exist' -- description
    );
    SELECT has_function(
        'admin__search_users', -- function name
        ARRAY['text','text','text','text','date'], -- argument types
        'Function admin__search_users(text, text, text, text, date) should exist' -- description
    );
    SELECT has_function(
        'user__change_password', -- function name
        ARRAY['text'], -- argument types
        'Function user__change_password(text) should exist' -- description
    );
    SELECT has_function(
        'user__check_my_expiration', -- function name
        '{}'::text[], -- argument types
        'Function user__check_my_expiration() should exist' -- description
    );
    SELECT has_function(
        'user__get_all_users', -- function name
        '{}'::text[], -- argument types
        'Function user__get_all_users() should exist' -- description
    );
    SELECT has_function(
        'user__get_preferences', -- function name
        ARRAY['integer'], -- argument types
        'Function user__get_preferences(integer) should exist' -- description
    );
    SELECT has_function(
        'user__save_preferences', -- function name
        ARRAY['text','text','text','text','text'], -- argument types
        'Function user__save_preferences(text, text, text, text, text) should exist' -- description
    );

   -- Run tests.

    SELECT ok(true, 'No specific admin tests yet!');

   -- Finish the tests and clean up.
    SELECT * FROM finish();

ROLLBACK;
