BEGIN;
    -- ====================================================================
    -- Setup
    -- ====================================================================

    -- Load the TAP functions.
    CREATE EXTENSION pgtap;
    SET client_min_messages TO warning;

    -- Plan the tests.

    SELECT plan(12);

    -- Add data

    \i xt/data/42-pg/Base.sql

    -- ====================================================================
    -- Required tables
    -- ====================================================================

    -- Tests

    -- Validate required tables

--    SELECT has_table('business');

    -- ====================================================================
    -- Required functions
    -- ====================================================================

    -- Tests

    -- Validate required functions
    -- One has_function() call per VALUES row, in the original order.
    -- budget__get_notes(integer) is listed twice, as in the original file.

    SELECT has_function(t.fn, t.args)
      FROM (VALUES
                ( 1, 'budget__get_info',
                     ARRAY['integer']),
                ( 2, 'budget__get_business_units',
                     ARRAY['integer']),
                ( 3, 'budget__search',
                     ARRAY['date', 'date', 'date', 'text', 'text', 'integer',
                           'integer', 'integer', 'integer[]', 'boolean',
                           'boolean']),
                ( 4, 'budget__save_info',
                     ARRAY['integer', 'date', 'date', 'text', 'text',
                           'integer[]']),
                ( 5, 'budget__save_details',
                     ARRAY['integer', 'text[]']),
                ( 6, 'budget__get_details',
                     ARRAY['integer']),
                ( 7, 'budget__get_notes',
                     ARRAY['integer']),
                ( 8, 'budget__save_note',
                     ARRAY['integer', 'text', 'text']),
                ( 9, 'budget__get_notes',
                     ARRAY['integer']),
                (10, 'budget__variance_report',
                     ARRAY['integer']),
                (11, 'budget__mark_obsolete',
                     ARRAY['integer']),
                (12, 'budget__reject',
                     ARRAY['integer'])
           ) AS t(seq, fn, args)
     ORDER BY t.seq;

    -- ====================================================================
    -- Finish
    -- ====================================================================

    -- Run tests

--    PREPARE test AS select ...;
--    SELECT results_eq('test',result,'Description');
--    DEALLOCATE test;

    -- Finish the tests and clean up.
    SELECT * FROM finish();

ROLLBACK;
