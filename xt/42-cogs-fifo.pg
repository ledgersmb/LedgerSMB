                  FROM acc_trans
                 WHERE chart_id = -5102),
               -225::numeric,
               'Series 5, step 2: expense account -5102 total is -225 after AR -5206 run');

    SELECT results_eq(
               format('SELECT allocated FROM invoice WHERE id = %L', t.id),
               format('VALUES (%L::numeric)', t.expected),
               'Series 5, step 2, after AR -5206 run: ' || t.label)
      FROM (VALUES (-5205,  -75, 'invoice -5205 allocated is -75'),
                   (-5206,  150, 'invoice -5206 allocated is 150'),
                   (-5204,   75, 'invoice -5204 allocated is 75')
           ) AS t(id, expected, label);

