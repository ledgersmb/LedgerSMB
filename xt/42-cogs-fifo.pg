               $$ VALUES (150::numeric) $$,
               'Series 5, step 1, after AR -5202 run: invoice -5202 allocated is 150');

    -- ------------------------------------------------------------------
    -- Step 2: Reversal of AR invoice with allocation, reallocates to
    -- invoice without and AP
    -- ------------------------------------------------------------------

    -- Test outline:
    --  * Set up an ar invoice and an ap invoice, each at 150 units
    --  * Allocate these against each other
    --  * Set up another ar invoice at 75 units
    --  * Allocate the new invoice / no units availeble == no effect
    --  * Reverse the original AR invoice at 150 units
    --  * Allocate the reversal invoice
    --  * The second AR invoice is now allocated
    --  * The AP invoice is 50% de-allocated

    -- Fixtures

    --  * Set up an ar invoice and an ap invoice, each at 150 units

    INSERT INTO transactions
           (id, transdate, trans_type_code, approved)
    VALUES (-5203, now() - '4 days'::interval, 'ar', TRUE);
    INSERT INTO open_item
           (item_number, item_type, account_id)
    VALUES ('test5003', 'ar', -5102);
    INSERT INTO ar
           (trans_id, open_item_id, invoice, invnumber,
            entity_credit_account)
    VALUES (-5203, currval('open_item_id_seq'), TRUE, 'test5003', -2000);
    INSERT INTO invoice
           (id, trans_id, parts_id, qty, allocated, sellprice)
    VALUES (-5203, -5203, -5, 150, 0, 3);

    INSERT INTO transactions
           (id, transdate, trans_type_code, approved)
    VALUES (-5204, now() - '4 days'::interval, 'ap', TRUE);
    INSERT INTO open_item
           (item_number, item_type, account_id)
    VALUES ('test5004', 'ap', -5102);
    INSERT INTO ap
           (trans_id, open_item_id, invoice, invnumber,
            entity_credit_account)
    VALUES (-5204, currval('open_item_id_seq'), TRUE, 'test5004', -2000);
    INSERT INTO invoice
           (id, trans_id, parts_id, qty, allocated, sellprice)
    VALUES (-5204, -5204, -5, -150, 0, 3);

    -- Tests

    --  * Allocate these against each other
    SELECT is(
               cogs__add_for_ap_line(-5204),
               150::numeric,
               'Series 5, step 2: cogs__add_for_ap_line(-5204) returns 150');

    -- VERIFY
    -- 150 units @ 3 (invoice -5204) = 450
    SELECT is(
               (SELECT sum(amount_bc)
                  FROM acc_trans
                 WHERE chart_id = -5102),
               -450::numeric,
               'Series 5, step 2: expense account -5102 total is -450 after AP -5204 run');

    SELECT results_eq(
               $$ SELECT allocated FROM invoice WHERE id = -5203 $$,
               $$ VALUES (-150::numeric) $$,
               'Series 5, step 2, after AP -5204 run: invoice -5203 allocated is -150');

    SELECT results_eq(
               $$ SELECT allocated FROM invoice WHERE id = -5204 $$,
               $$ VALUES (150::numeric) $$,
               'Series 5, step 2, after AP -5204 run: invoice -5204 allocated is 150');

    -- Fixtures

    --  * Set up another ar invoice at 75 units
    INSERT INTO transactions
           (id, transdate, trans_type_code, approved)
    VALUES (-5205, now() - '4 days'::interval, 'ar', TRUE);
    INSERT INTO open_item
           (item_number, item_type, account_id)
    VALUES ('test5005', 'ar', -5102);
    INSERT INTO ar
           (trans_id, open_item_id, invoice, invnumber,
            entity_credit_account)
    VALUES (-5205, currval('open_item_id_seq'), TRUE, 'test5005', -2000);
    INSERT INTO invoice
           (id, trans_id, parts_id, qty, allocated, sellprice)
    VALUES (-5205, -5205, -5, 75, 0, 3);

    -- Tests

    --  * Allocate the new invoice / no units availeble == no effect
    SELECT is(
               cogs__add_for_ar_line(-5205),
               0::numeric,
               'Series 5, step 2: cogs__add_for_ar_line(-5205) returns 0');

    -- VERIFY
    SELECT is(
               (SELECT sum(amount_bc)
                  FROM acc_trans
                 WHERE chart_id = -5102),
               -450::numeric,
               'Series 5, step 2: expense account -5102 total is still -450 after AR -5205 run');

    SELECT results_eq(
               $$ SELECT allocated FROM invoice WHERE id = -5205 $$,
               $$ VALUES (0::numeric) $$,
               'Series 5, step 2, after AR -5205 run: invoice -5205 allocated is 0');

    -- Fixtures

    --  * Reverse the original AR invoice at 150 units
    INSERT INTO transactions
           (id, transdate, trans_type_code, approved)
    VALUES (-5206, now() - '4 days'::interval, 'ar', TRUE);
    INSERT INTO open_item
           (item_number, item_type, account_id)
    VALUES ('test5006-rev3', 'ar', -5102);
    INSERT INTO ar
           (trans_id, open_item_id, invoice, invnumber,
            entity_credit_account)
    VALUES (-5206, currval('open_item_id_seq'), TRUE, 'test5006-rev3', -2000);
