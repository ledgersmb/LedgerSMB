    INSERT INTO ap
           (trans_id, open_item_id, invoice, invnumber,
            entity_credit_account)
    VALUES (-5209, currval('open_item_id_seq'), TRUE, 'test5009', -2000);
    INSERT INTO invoice
           (id, trans_id, parts_id, qty, allocated, sellprice)
    VALUES (-5209, -5209, -6, -75, 0, 3);

    -- Tests

    SELECT is(
               cogs__add_for_ap_line(-5209)::numeric,
               0::numeric,
               'Series 5, step 3: cogs__add_for_ap_line(-5209) returns 0');

    SELECT is(
               (SELECT sum(amount_bc)
                  FROM acc_trans
                 WHERE chart_id = -6102),
               -450::numeric,
               'Series 5, step 3: expense account -6102 total is still -450 after AP -5209 run');

    SELECT is(allocated, 0::numeric, 'Series 5, step 3, after AP -5209 run: invoice -5209 allocated is 0')
      FROM invoice
     WHERE id = -5209;

    -- Fixtures

    INSERT INTO transactions
           (id, transdate, trans_type_code, approved)
    VALUES (-5210, now() - '4 days'::interval, 'ap', TRUE);
    INSERT INTO open_item
           (item_number, item_type, account_id)
    VALUES ('test5010-rev8', 'ap', -5102);
    INSERT INTO ap
           (trans_id, open_item_id, invoice, invnumber,
            entity_credit_account)
    VALUES (-5210, currval('open_item_id_seq'), TRUE, 'test5010-rev8', -2000);
    INSERT INTO invoice
           (id, trans_id, parts_id, qty, allocated, sellprice)
    VALUES (-5210, -5210, -6, 150, 0, 3);

    -- Tests

    SELECT is(
               cogs__add_for_ap_line(-5210)::numeric,
               -150::numeric,
               'Series 5, step 3: cogs__add_for_ap_line(-5210) returns -150');

    -- 75 units @ 3 remain allocated = 225
    SELECT is(
               (SELECT sum(amount_bc)
                  FROM acc_trans
                 WHERE chart_id = -6102),
               -225::numeric,
               'Series 5, step 3: expense account -6102 total is -225 after AP -5210 run');

    SELECT is(
               ARRAY(SELECT allocated
                       FROM invoice
                      WHERE id IN (-5207, -5208, -5209, -5210)
                      ORDER BY id),
               ARRAY[-150, 75, 150, -75]::numeric[],
               'Series 5, step 3, after AP -5210 run: invoices -5210, -5209, -5208, -5207 allocated are -150, 75, 150, -75');


    -- ==================================================================
    -- GOODS HISTORY SEARCH
    -- ==================================================================

/*
    # Goods history search


*/

    -- Fixtures: none (counts the 30 invoices created by the series above)

    -- Tests

    SELECT is(
               (SELECT count(*)
                  FROM goods__history(NULL, NULL, NULL, NULL, NULL,
                                      FALSE, FALSE, FALSE, FALSE,
                                      TRUE, TRUE)),
               30::bigint,
               'goods__history returns 30 lines for AR and AP (flags TRUE, TRUE)');

    SELECT is(
               (SELECT count(*)
                  FROM goods__history(NULL, NULL, NULL, NULL, NULL,
                                      FALSE, FALSE, FALSE, FALSE,
                                      TRUE, FALSE)),
               15::bigint,
               'goods__history returns 15 AR lines (flags TRUE, FALSE)');

    SELECT is(
               (SELECT count(*)
                  FROM goods__history(NULL, NULL, NULL, NULL, NULL,
                                      FALSE, FALSE, FALSE, FALSE,
                                      FALSE, TRUE)),
               15::bigint,
               'goods__history returns 15 AP lines (flags FALSE, TRUE)');

    SELECT is(
               (SELECT count(*)
                  FROM goods__history(NULL, NULL, NULL, NULL, NULL,
                                      FALSE, FALSE, FALSE, FALSE,
                                      FALSE, FALSE)),
               0::bigint,
               'goods__history returns 0 lines when both are excluded (flags FALSE, FALSE)');

    SELECT is(
               (SELECT count(*)
                  FROM goods__history(NULL, NULL, NULL, NULL, NULL,
                                      NULL, NULL, NULL, NULL,
                                      NULL, NULL)),
               30::bigint,
               'goods__history returns 30 lines with all-default (NULL) arguments');

    -- Finish the tests and clean up.
    SELECT * FROM finish();

