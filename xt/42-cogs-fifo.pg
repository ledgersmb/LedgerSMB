    VALUES (-5206, -5206, -5, -150, 0, 3);

    -- Tests

    SELECT is(
               cogs__add_for_ar_line(-5206),
               -150::numeric,
               'Series 5, step 2: cogs__add_for_ar_line(-5206) returns -150');

    -- -450 reversed by -5206, then 75 units @ 3 allocated to -5205 = 225
    SELECT is(
