BEGIN;
    -- Load the TAP functions.
    CREATE EXTENSION pgtap;
    SET client_min_messages TO warning;

    -- Plan the tests.

    SELECT plan(132);

    -- Add data

    \i xt/data/42-pg/Base.sql


    -- ==================================================================
    -- SETUP
    -- ==================================================================

    -- Id legend (every id created by this file is negative):
    --   * -1000 is reused across tables: account_heading, entity and
    --     entity_credit_account each have a row with id -1000. The second
    --     entity_credit_account is -2000.
    --   * Series N (N = 1..5) uses part -N and accounts -N101 .. -N104
    --     (categories A, E, E, I). Part -6 ('TS5/part2') also belongs to
    --     series 5 and uses accounts -6101 .. -6104. COGS is read from
    --     acc_trans.chart_id = -N102 (-6102 for part -6).
    --   * Invoice ids: transactions.id = invoice.id = invoice.trans_id =
    --     -SNNN, where S is the series (1..5) and NNN counts up from 201:
    --     series 1 = -1201..-1205, series 2 = -2201..-2206,
    --     series 3 = -3201..-3205, series 4 = -4201..-4204,
    --     series 5 = -5201..-5210.
    --   * open_item ids are not explicit: they come from open_item_id_seq and
    --     are linked to ar/ap rows with currval('open_item_id_seq').
    --   * Supplied by the include or the schema, not created here:
    --     country_id 232 (entity), currency 'XTS', and all tables, functions
    --     and sequences used below.

    -- Schema checks (tests; no fixtures needed)

    -- Validate required tables

    SELECT has_table(t.table_name::name)
      FROM (VALUES ('account'),
                   ('account_heading'),
                   ('ap'),
                   ('ar'),
                   ('entity_credit_account'),
                   ('entity'),
                   ('invoice'),
                   ('parts')
           ) AS t(table_name);

    -- Validate required functions

    SELECT has_function(t.function_name::name, t.arg_types::name[])
      FROM (VALUES ('cogs__add_for_ap',
                    ARRAY['integer', 'numeric', 'numeric', 'date']),
                   ('cogs__add_for_ap_line', ARRAY['integer', 'date']),
                   ('cogs__add_for_ar', ARRAY['integer', 'numeric']),
                   ('cogs__add_for_ar_line', ARRAY['integer']),
                   ('cogs__reverse_ap', ARRAY['integer', 'numeric']),
                   ('cogs__reverse_ar', ARRAY['integer', 'numeric'])
           ) AS t(function_name, arg_types);

    -- Shared fixtures

    INSERT INTO account_heading
           (id, accno, description)
    VALUES (-1000, '-1000', 'Test heading');

    INSERT INTO account
           (id, accno, category, description, heading)
    VALUES (-1101, 'TEST1001', 'A', 'COGS test series 1 Inventory', -1000),
           (-1102, 'TEST1002', 'E', 'COGS test series 1 COGS', -1000),
           (-1103, 'TEST1003', 'E', 'COGS test series 1 returns', -1000),
           (-1104, 'TEST1004', 'I', 'COGS test series 1 income', -1000),
           (-2101, 'TEST2001', 'A', 'COGS test series 2 Inventory', -1000),
           (-2102, 'TEST2002', 'E', 'COGS test series 1 COGS', -1000),
           (-2103, 'TEST2003', 'E', 'COGS test series 1 returns', -1000),
           (-2104, 'TEST2004', 'I', 'COGS test series 1 income', -1000),
           (-3101, 'TEST3002', 'A', 'COGS test series 2 Inventory', -1000),
           (-3102, 'TEST3001', 'E', 'COGS test series 1 COGS', -1000),
           (-3103, 'TEST3003', 'E', 'COGS test series 1 returns', -1000),
           (-3104, 'TEST3004', 'I', 'COGS test series 1 income', -1000),
           (-4101, 'TEST4001', 'A', 'COGS test series 2 Inventory', -1000),
           (-4102, 'TEST4002', 'E', 'COGS test series 1 COGS', -1000),
           (-4103, 'TEST4003', 'E', 'COGS test series 1 returns', -1000),
           (-4104, 'TEST4004', 'I', 'COGS test series 1 income', -1000),
           (-5101, 'TEST5001', 'A', 'COGS test series 2 Inventory', -1000),
           (-5102, 'TEST5002', 'E', 'COGS test series 1 COGS', -1000),
           (-5103, 'TEST5003', 'E', 'COGS test series 1 returns', -1000),
           (-5104, 'TEST5004', 'I', 'COGS test series 1 income', -1000),
           (-6101, 'TEST6001', 'A', 'COGS test series 2 Inventory', -1000),
           (-6102, 'TEST6002', 'E', 'COGS test series 1 COGS', -1000),
           (-6103, 'TEST6003', 'E', 'COGS test series 1 returns', -1000),
           (-6104, 'TEST6004', 'I', 'COGS test series 1 income', -1000);

    INSERT INTO parts
           (id, partnumber, description, income_accno_id, expense_accno_id,
            inventory_accno_id, returns_accno_id)
    VALUES (-1, 'TS1', 'COGS Test Series 1',
            -1101, -1102, -1104, -1103),
           (-2, 'TS2', 'COGS Test Series 2',
            -2101, -2102, -2104, -2103),
           (-3, 'TS3', 'COGS Test Series 3',
            -3101, -3102, -3104, -3103),
           (-4, 'TS4', 'COGS Test Series 4',
            -4101, -4102, -4104, -4103),
           (-5, 'TS5', 'COGS Test Series 5',
            -5101, -5102, -5104, -5103),
           (-6, 'TS5/part2', 'COGS Test Series 5/part2',
            -6101, -6102, -6104, -6103);

    INSERT INTO entity
           (id, name, country_id)
    VALUES (-1000, 'Test act', 232);

    INSERT INTO entity_credit_account
           (id, entity_class, meta_number, entity_id, curr,
            ar_ap_account_id)
    VALUES (-1000, 1, 'cogs test1', -1000, 'XTS', -1103),
           (-2000, 2, 'cogs test2', -1000, 'XTS', -1103);


    -- ==================================================================
    -- SERIES 1: AR before AP
    -- ==================================================================

/*
    # First series of tests, AR before AP

    This test concerns 3 invoices:

    1. id=-1201; AR invoice
    2. id=-1202; AP invoice
    3. id=-1203, the second AR invoice
    4. id=-1204, the second AP invoice
    5. id=-1205, the third AP invoice

    Summary of steps:

    1. sell 100 items (back-order: 100)
    2. purchase 75 items (back-order: 25 / invoice -1201)
    3. sell 100 items (back-order: 25 @ -1201 / 100 @ -1203)
    4. purchase 75 (back-order: 0 @ -1201 / 50 @ -1203)
    5. purchase 50 (back-order: 0)

*/

    -- ------------------------------------------------------------------
    -- Step 1: Create invoice -1201
    -- ------------------------------------------------------------------

    -- Fixtures

    INSERT INTO transactions
           (id, transdate, trans_type_code, approved)
    VALUES (-1201, now() - '10 days'::interval, 'ar', TRUE);
    INSERT INTO open_item
           (item_number, item_type, account_id)
    VALUES ('test1001', 'ar', -1102);
    INSERT INTO ar
           (trans_id, open_item_id, invoice, invnumber,
            entity_credit_account)
    VALUES (-1201, currval('open_item_id_seq'), TRUE, 'test1001', -2000);
    INSERT INTO invoice
           (id, trans_id, parts_id, qty, allocated, sellprice)
    VALUES (-1201, -1201, -1, 100, 0, 3);

    -- Tests

    SELECT is(
               (SELECT sum(amount_bc)
                  FROM acc_trans
                 WHERE trans_id = -1201 AND chart_id = -1102),
               NULL,
               'Series 1, before any COGS run: invoice -1201 COGS is NULL');

    -- ------------------------------------------------------------------
    -- Step 2: Generate COGS for invoice -1201 (AR)
    -- ------------------------------------------------------------------

    -- Fixtures

    SELECT cogs__add_for_ar_line(-1201);

    -- Tests

    SELECT is(
               (SELECT sum(amount_bc)
                  FROM acc_trans
                 WHERE trans_id = -1201 AND chart_id = -1102),
               0::numeric,
               'Series 1, after AR -1201 run: invoice -1201 COGS is 0');

    -- ------------------------------------------------------------------
    -- Step 3: Create invoice -1202 (AP) and post COGS
    -- ------------------------------------------------------------------

    -- Fixtures

    INSERT INTO transactions
           (id, transdate, trans_type_code, approved)
    VALUES (-1202, now() - '10 days'::interval, 'ap', TRUE);
    INSERT INTO open_item
           (item_number, item_type, account_id)
    VALUES ('test1002', 'ap', -1102);
    INSERT INTO ap
           (trans_id, open_item_id, invoice, invnumber,
            entity_credit_account)
    VALUES (-1202, currval('open_item_id_seq'), TRUE, 'test1002', -1000);
    INSERT INTO invoice
           (id, trans_id, parts_id, qty, allocated, sellprice)
    VALUES (-1202, -1202, -1, -75, 0, 0.5);

    SELECT cogs__add_for_ap_line(-1202);

    -- Tests

    -- -1201: 75 units @ 0.5 (invoice -1202) = 37.5
    SELECT is(
               (SELECT sum(amount_bc)
                  FROM acc_trans
                 WHERE trans_id = -1201 AND chart_id = -1102),
               -37.5::numeric,
               'Series 1, after AP -1202 run: invoice -1201 COGS is -37.5');

    SELECT is(
               ARRAY(SELECT allocated
                       FROM invoice
                      WHERE id IN (-1201, -1202)
                      ORDER BY id),
               ARRAY[75, -75]::numeric[],
               'Series 1, after AP -1202 run: invoices -1202, -1201 allocated are 75, -75');

    -- ------------------------------------------------------------------
    -- Step 4: Create invoice -1203 (AR) and post COGS
    -- ------------------------------------------------------------------

    -- Fixtures

    INSERT INTO transactions
           (id, transdate, trans_type_code, approved)
    VALUES (-1203, now() - '9 days'::interval, 'ar', TRUE);
    INSERT INTO open_item
           (item_number, item_type, account_id)
    VALUES ('test1003', 'ar', -1102);
    INSERT INTO ar
           (trans_id, open_item_id, invoice, invnumber,
            entity_credit_account)
    VALUES (-1203, currval('open_item_id_seq'), TRUE, 'test1003', -2000);
    INSERT INTO invoice
           (id, trans_id, parts_id, qty, allocated, sellprice)
    VALUES (-1203, -1203, -1, 100, 0, 3);

    -- Tests (before the COGS run)

    SELECT is(
               (SELECT sum(amount_bc)
                  FROM acc_trans
                 WHERE trans_id = -1203 AND chart_id = -1102),
               NULL,
               'Series 1, before AR -1203 run: invoice -1203 COGS is NULL');

    -- Fixtures (COGS run)

    SELECT cogs__add_for_ar_line(-1203);

    -- Tests (after the COGS run)

    SELECT is(
               ARRAY(SELECT allocated
                       FROM invoice
                      WHERE id IN (-1201, -1202, -1203)
                      ORDER BY id),
               ARRAY[0, 75, -75]::numeric[],
               'Series 1, after AR -1203 run: invoices -1203, -1202, -1201 allocated are 0, 75, -75');

    SELECT is(
               (SELECT sum(amount_bc)
                  FROM acc_trans
                 WHERE trans_id = -1201 AND chart_id = -1102),
               -37.5::numeric,
               'Series 1, after AR -1203 run: invoice -1201 COGS is -37.5');

    SELECT is(
               (SELECT sum(amount_bc)
                  FROM acc_trans
                 WHERE trans_id = -1203 AND chart_id = -1102),
               0::numeric,
               'Series 1, after AR -1203 run: invoice -1203 COGS is 0');

    -- ------------------------------------------------------------------
    -- Step 5: Create invoice -1204 (AP) and post COGS
    -- ------------------------------------------------------------------

    -- Fixtures

    INSERT INTO transactions
           (id, transdate, trans_type_code, approved)
    VALUES (-1204, now() - '8 days'::interval, 'ap', TRUE);
    INSERT INTO open_item
           (item_number, item_type, account_id)
    VALUES ('test1004', 'ap', -1102);
    INSERT INTO ap
           (trans_id, open_item_id, invoice, invnumber,
            entity_credit_account)
    VALUES (-1204, currval('open_item_id_seq'), TRUE, 'test1004', -1000);
    INSERT INTO invoice
           (id, trans_id, parts_id, qty, allocated, sellprice)
    VALUES (-1204, -1204, -1, -75, 0, 1);

    SELECT cogs__add_for_ap_line(-1204);

    -- Tests

    SELECT results_eq(
               format('SELECT allocated FROM invoice WHERE id = %L', t.id),
               format('VALUES (%L::numeric)', t.expected),
               'Series 1, after AP -1204 run: ' || t.label)
      FROM (VALUES (-1201, -100, 'invoice -1201 allocated is -100'),
                   (-1202,   75, 'invoice -1202 allocated is 75'),
                   (-1203,  -50, 'invoice -1203 allocated is -50'),
                   (-1204,   75, 'invoice -1204 allocated is 75')
           ) AS t(id, expected, label);

    -- -1201: 37.5 + 25 units @ 1 (invoice -1204) = 62.5
    -- -1203: 50 units @ 1 (invoice -1204) = 50
    SELECT is(
               (SELECT sum(amount_bc)
                  FROM acc_trans
                 WHERE trans_id = -1201 AND chart_id = -1102),
               -62.5::numeric,
               'Series 1, after AP -1204 run: invoice -1201 COGS is -62.5');

    SELECT is(
               (SELECT sum(amount_bc)
                  FROM acc_trans
                 WHERE trans_id = -1203 AND chart_id = -1102),
               -50::numeric,
               'Series 1, after AP -1204 run: invoice -1203 COGS is -50');

    -- ------------------------------------------------------------------
    -- Step 6: Create invoice -1205 (AP) and post COGS
    -- ------------------------------------------------------------------

    -- Fixtures

    INSERT INTO transactions
           (id, transdate, trans_type_code, approved)
    VALUES (-1205, now() - '8 days'::interval, 'ap', TRUE);
    --###OPEN_ITEMS_ARAP: this indicates a problem: AP items aren't de-duplicated on their "invnumber"
    INSERT INTO open_item
           (item_number, item_type, account_id)
    VALUES ('test1004/2', 'ap', -1102);
    INSERT INTO ap
           (trans_id, open_item_id, invoice, invnumber,
            entity_credit_account)
    VALUES (-1205, currval('open_item_id_seq'), TRUE, 'test1004', -1000);
    INSERT INTO invoice
           (id, trans_id, parts_id, qty, allocated, sellprice)
    VALUES (-1205, -1205, -1, -50, 0, 2);

    SELECT cogs__add_for_ap_line(-1205);

    -- Tests

    SELECT results_eq(
               format('SELECT allocated FROM invoice WHERE id = %L', t.id),
               format('VALUES (%L::numeric)', t.expected),
               'Series 1, after AP -1205 run: ' || t.label)
      FROM (VALUES (-1201, -100, 'invoice -1201 allocated is -100'),
                   (-1202,   75, 'invoice -1202 allocated is 75'),
                   (-1203, -100, 'invoice -1203 allocated is -100'),
                   (-1204,   75, 'invoice -1204 allocated is 75'),
                   (-1205,   50, 'invoice -1205 allocated is 50')
           ) AS t(id, expected, label);

    -- -1201 is unchanged. -1203: 50 + 50 units @ 2 (invoice -1205) = 150
    SELECT is(
               (SELECT sum(amount_bc)
                  FROM acc_trans
                 WHERE trans_id = -1201 AND chart_id = -1102),
               -62.5::numeric,
               'Series 1, after AP -1205 run: invoice -1201 COGS is -62.5');

    SELECT is(
               (SELECT sum(amount_bc)
                  FROM acc_trans
                 WHERE trans_id = -1203 AND chart_id = -1102),
               -150::numeric,
               'Series 1, after AP -1205 run: invoice -1203 COGS is -150');


    -- ==================================================================
    -- SERIES 2: AP invoices first, COGS added to AR
    -- ==================================================================

/*
    # Series 2, AP invoices first, cogs only added to AR


*/

    -- ------------------------------------------------------------------
    -- Invoice -2201 (AP)
    -- ------------------------------------------------------------------

    -- Fixtures

    INSERT INTO transactions
           (id, transdate, trans_type_code, approved)
    VALUES (-2201, now() - '10 days'::interval, 'ap', TRUE);
    INSERT INTO open_item
           (item_number, item_type, account_id)
    VALUES ('test2001', 'ap', -2102);
    INSERT INTO ap
           (trans_id, open_item_id, invoice, invnumber,
            entity_credit_account)
    VALUES (-2201, currval('open_item_id_seq'), TRUE, 'test2001', -1000);
    INSERT INTO invoice
           (id, trans_id, parts_id, qty, allocated, sellprice)
    VALUES (-2201, -2201, -2, -100, 0, 0.5);

    SELECT cogs__add_for_ap_line(-2201);

    -- Tests

    SELECT results_eq(
               $$ SELECT allocated FROM invoice WHERE id = -2201 $$,
               $$ VALUES (0::numeric) $$,
               'Series 2, after AP -2201 run: invoice -2201 allocated is 0');

    -- ------------------------------------------------------------------
    -- Invoice -2202 (AR)
    -- ------------------------------------------------------------------

    -- Fixtures

    INSERT INTO transactions
           (id, transdate, trans_type_code, approved)
    VALUES (-2202, now() - '10 days'::interval, 'ar', TRUE);
    -- 'ap' invoice by the same number exists!
    INSERT INTO open_item
           (item_number, item_type, account_id)
    VALUES ('test2001/ar', 'ar', -2102);
    INSERT INTO ar
           (trans_id, open_item_id, invoice, invnumber,
            entity_credit_account)
    VALUES (-2202, currval('open_item_id_seq'), TRUE, 'test2001', -2000);
    INSERT INTO invoice
           (id, trans_id, parts_id, qty, allocated, sellprice)
    VALUES (-2202, -2202, -2, 75, 0, 3);

    SELECT cogs__add_for_ar_line(-2202);

    -- Tests

    SELECT results_eq(
               $$ SELECT allocated FROM invoice WHERE id = -2201 $$,
               $$ VALUES (75::numeric) $$,
               'Series 2, after AR -2202 run: invoice -2201 allocated is 75');

    SELECT results_eq(
               $$ SELECT allocated FROM invoice WHERE id = -2202 $$,
               $$ VALUES (-75::numeric) $$,
               'Series 2, after AR -2202 run: invoice -2202 allocated is -75');

    -- -2202: 75 units @ 0.5 (invoice -2201) = 37.5
    SELECT is(
               (SELECT sum(amount_bc)
                  FROM acc_trans
                 WHERE trans_id = -2202 AND chart_id = -2102),
               -37.5::numeric,
               'Series 2, after AR -2202 run: invoice -2202 COGS is -37.5');

    -- ------------------------------------------------------------------
    -- Invoice -2203 (AP)
    -- ------------------------------------------------------------------

    -- Fixtures

    INSERT INTO transactions
           (id, transdate, trans_type_code, approved)
    VALUES (-2203, now() - '9 days'::interval, 'ap', TRUE);
    INSERT INTO open_item
           (item_number, item_type, account_id)
    VALUES ('test2003', 'ap', -2103);
    INSERT INTO ap
           (trans_id, open_item_id, invoice, invnumber,
            entity_credit_account)
    VALUES (-2203, currval('open_item_id_seq'), TRUE, 'test2003', -1000);
    INSERT INTO invoice
           (id, trans_id, parts_id, qty, allocated, sellprice)
    VALUES (-2203, -2203, -2, -100, 0, 1);

    SELECT cogs__add_for_ap_line(-2203);

    -- Tests

    SELECT results_eq(
               format('SELECT allocated FROM invoice WHERE id = %L', t.id),
               format('VALUES (%L::numeric)', t.expected),
               'Series 2, after AP -2203 run: ' || t.label)
      FROM (VALUES (-2201,   75, 'invoice -2201 allocated is 75'),
                   (-2202,  -75, 'invoice -2202 allocated is -75'),
                   (-2203,    0, 'invoice -2203 allocated is 0')
           ) AS t(id, expected, label);

    -- ------------------------------------------------------------------
    -- Invoice -2204 (AR)
    -- ------------------------------------------------------------------

    -- Fixtures

    INSERT INTO transactions
           (id, transdate, trans_type_code, approved)
    VALUES (-2204, now() - '7 days'::interval, 'ar', TRUE);
    INSERT INTO open_item
           (item_number, item_type, account_id)
    VALUES ('test2004', 'ar', -2102);
    INSERT INTO ar
           (trans_id, open_item_id, invoice, invnumber,
            entity_credit_account)
    VALUES (-2204, currval('open_item_id_seq'), TRUE, 'test2004', -2000);
    INSERT INTO invoice
           (id, trans_id, parts_id, qty, allocated, sellprice)
    VALUES (-2204, -2204, -2, 75, 0, 3);

    SELECT cogs__add_for_ar_line(-2204);

    -- Tests

    SELECT results_eq(
               format('SELECT allocated FROM invoice WHERE id = %L', t.id),
               format('VALUES (%L::numeric)', t.expected),
               'Series 2, after AR -2204 run: ' || t.label)
      FROM (VALUES (-2201,  100, 'invoice -2201 allocated is 100'),
                   (-2202,  -75, 'invoice -2202 allocated is -75'),
                   (-2203,   50, 'invoice -2203 allocated is 50'),
                   (-2204,  -75, 'invoice -2204 allocated is -75')
           ) AS t(id, expected, label);

    -- -2204: 25 units @ 0.5 (rest of -2201) + 50 units @ 1 (-2203) = 62.5
    SELECT is(
               (SELECT sum(amount_bc)
                  FROM acc_trans
                 WHERE trans_id = -2202 AND chart_id = -2102),
               -37.5::numeric,
               'Series 2, after AR -2204 run: invoice -2202 COGS is -37.5');

    SELECT is(
               (SELECT sum(amount_bc)
                  FROM acc_trans
                 WHERE trans_id = -2204 AND chart_id = -2102),
               -62.5::numeric,
               'Series 2, after AR -2204 run: invoice -2204 COGS is -62.5');

    -- ------------------------------------------------------------------
    -- Invoice -2205 (AR)
    -- ------------------------------------------------------------------

    -- Fixtures

    INSERT INTO transactions
           (id, transdate, trans_type_code, approved)
    VALUES (-2205, now() - '5 days'::interval, 'ar', TRUE);
    INSERT INTO open_item
           (item_number, item_type, account_id)
    VALUES ('test2005', 'ar', -2102);
    INSERT INTO ar
           (trans_id, open_item_id, invoice, invnumber,
            entity_credit_account)
    VALUES (-2205, currval('open_item_id_seq'), TRUE, 'test2005', -2000);
    INSERT INTO invoice
           (id, trans_id, parts_id, qty, allocated, sellprice)
    VALUES (-2205, -2205, -2, 50, 0, 3);

    SELECT cogs__add_for_ar_line(-2205);

    -- Tests

    SELECT results_eq(
               format('SELECT allocated FROM invoice WHERE id = %L', t.id),
               format('VALUES (%L::numeric)', t.expected),
               'Series 2, after AR -2205 run: ' || t.label)
      FROM (VALUES (-2201,  100, 'invoice -2201 allocated is 100'),
                   (-2202,  -75, 'invoice -2202 allocated is -75'),
                   (-2203,  100, 'invoice -2203 allocated is 100'),
                   (-2204,  -75, 'invoice -2204 allocated is -75'),
                   (-2205,  -50, 'invoice -2205 allocated is -50')
           ) AS t(id, expected, label);

    -- -2205: 50 units @ 1 (rest of -2203) = 50
    SELECT is(
               (SELECT sum(amount_bc)
                  FROM acc_trans
                 WHERE trans_id = t.trans_id AND chart_id = -2102),
               t.expected::numeric,
               'Series 2, after AR -2205 run: ' || t.label)
      FROM (VALUES (-2202, -37.5, 'invoice -2202 COGS is -37.5'),
                   (-2204, -62.5, 'invoice -2204 COGS is -62.5'),
                   (-2205,   -50, 'invoice -2205 COGS is -50')
           ) AS t(trans_id, expected, label);


    -- ==================================================================
    -- SERIES 2.5: AR reversal
    -- ==================================================================

/*
    # Series 2.5, AR reversal


*/

    -- ------------------------------------------------------------------
    -- Invoice -2206 (AR, reversal)
    -- ------------------------------------------------------------------

    -- Fixtures

    INSERT INTO transactions
           (id, transdate, trans_type_code, approved)
    VALUES (-2206, now() - '4 days'::interval, 'ar', TRUE);
    INSERT INTO open_item
           (item_number, item_type, account_id)
    VALUES ('test2006', 'ar', -2102);
    INSERT INTO ar
           (trans_id, open_item_id, invoice, invnumber,
            entity_credit_account)
    VALUES (-2206, currval('open_item_id_seq'), TRUE, 'test2006', -2000);
    INSERT INTO invoice
           (id, trans_id, parts_id, qty, allocated, sellprice)
    VALUES (-2206, -2206, -2, -150, 0, 3);

    SELECT cogs__add_for_ar_line(-2206);

    -- Tests

    SELECT results_eq(
               format('SELECT allocated FROM invoice WHERE id = %L', t.id),
               format('VALUES (%L::numeric)', t.expected),
               'Series 2.5, after AR -2206 run: ' || t.label)
      FROM (VALUES (-2201,   50, 'invoice -2201 allocated is 50'),
                   (-2202,  -75, 'invoice -2202 allocated is -75'),
                   (-2203,    0, 'invoice -2203 allocated is 0'),
                   (-2204,  -75, 'invoice -2204 allocated is -75'),
                   (-2205,  -50, 'invoice -2205 allocated is -50'),
                   (-2206,  150, 'invoice -2206 allocated is 150')
           ) AS t(id, expected, label);

    -- -2206: 50 units @ 0.5 (-2201) + 100 units @ 1 (-2203) = 125 released
    SELECT is(
               (SELECT sum(amount_bc)
                  FROM acc_trans
                 WHERE trans_id = t.trans_id AND chart_id = -2102),
               t.expected::numeric,
               'Series 2.5, after AR -2206 run: ' || t.label)
      FROM (VALUES (-2202, -37.5, 'invoice -2202 COGS is -37.5'),
                   (-2204, -62.5, 'invoice -2204 COGS is -62.5'),
                   (-2205,   -50, 'invoice -2205 COGS is -50'),
                   (-2206,   125, 'invoice -2206 COGS is 125')
           ) AS t(trans_id, expected, label);


    -- ==================================================================
    -- SERIES 3: Mixed
    -- ==================================================================

/*
    # Series 3, Mixed


*/

    -- ------------------------------------------------------------------
    -- Invoice -3201 (AP)
    -- ------------------------------------------------------------------

    -- Fixtures

    INSERT INTO transactions
