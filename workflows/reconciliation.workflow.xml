<workflow
    xmlns="http://ledgersmb.org/xml-schemas/workflows"
    type="reconciliation"
    persister="reconciliation">
  <description></description>

  <state name="INITIAL" autorun="yes">
    <action name="save" resulting-state="SAVED" />
  </state>

  <state name="SAVED">
    <action name="add_pending_items" resulting-state="SAVED" />
    <action name="delete" resulting-state="DELETED" />
    <action name="save" resulting-state="SAVED" />
    <action name="submit" resulting-state="SUBMITTED" />
    <action name="upload_statement" resulting-state="STMT_ITEMS_ADDED" />
  </state>

  <state name="SUBMITTED">
    <action name="approve" resulting-state="APPROVED" />
    <action name="delete" resulting-state="DELETED" />
    <action name="reject" resulting-state="SAVED" />
  </state>

  <state name="APPROVED" />

  <state name="DELETED" />
</workflow>
