<workflow
    xmlns="http://ledgersmb.org/xml-schemas/workflows"
    type="Email"
    persister="Email">
  <description>Handles lifecycle of e-mail</description>
  <state name="INITIAL" autorun="yes">
    <action name="save" resulting-state="INITIALIZED" />
  </state>
  <state name="INITIALIZED" autorun="yes">
    <action name="send"    resulting-state="EXPANDED">
      <condition name="sendImmediately" />
    </action>
    <!-- Save data as provided at workflow creation time -->
    <action name="save" resulting-state="CREATED">
      <condition name="!sendImmediately"/>
    </action>
  </state>
  <state name="CREATED">
    <action name="attach" resulting-state="NOCHANGE"/>
    <action name="save"   resulting-state="NOCHANGE" />
    <action name="send"   resulting-state="EXPANDED" />
    <action name="cancel" resulting-state="CANCELLED"/>

 <!--
      Commented out in anticipation of functionality to manage the queue

   <action name="Queue"  resulting-state="QUEUED">
     <condition name="Complete" />
  </action>
 -->
  </state>
 <!--
 <state name="QUEUED">
   <action name="send"   resulting-state="SENT">
     <condition name="Complete" />
  </action>
   <action name="cancel" resulting-state="CANCELLED"/>
 </state>
 -->

  <state name="EXPANDED" autorun="yes">
    <action name="do-send" resulting-state="SUCCESS" />
  </state>
  <state name="SUCCESS" />
  <state name="CANCELLED" />
</workflow>
