<workflow
    xmlns="http://ledgersmb.org/xml-schemas/workflows"
    type="Aging statement batch"
    persister="common">
  <description>Handles the lifecycle of a batch of aging reminders</description>
  <state name="INITIAL">
    <action name="complete" resulting-state="SUCCESS">
      <!--TODO: we need a condition checking all workflows being complete...-->
    </action>
    <action name="cancel"   resulting-state="CANCELLED"/>
  </state>
  <state name="SUCCESS" />
  <state name="CANCELLED" />
</workflow>
